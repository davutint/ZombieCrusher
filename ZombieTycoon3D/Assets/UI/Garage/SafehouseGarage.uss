:root {
    --garage-bg: rgba(8, 11, 14, 0.96);
    --panel-bg: rgba(18, 22, 27, 0.96);
    --panel-soft: rgba(26, 31, 37, 0.92);
    --panel-hover: rgba(37, 45, 53, 0.98);
    --border: rgba(255, 255, 255, 0.10);
    --border-strong: rgba(255, 255, 255, 0.18);
    --text: rgb(239, 244, 248);
    --text-soft: rgb(163, 174, 184);
    --text-dim: rgb(112, 124, 135);
    --accent: rgb(103, 186, 255);
    --accent-soft: rgba(103, 186, 255, 0.18);
    --positive: rgb(82, 214, 147);
    --negative: rgb(255, 102, 111);
}

.garage-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    color: var(--text);
}

.topbar {
    height: 76px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 28px;
    padding-right: 28px;
    background-color: var(--garage-bg);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.brand-row {
    flex-direction: row;
    align-items: center;
}

.brand-mark {
    margin-right: 11px;
    color: var(--accent);
    font-size: 18px;
}

.brand-title {
    color: var(--text);
    font-size: 19px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
}

.balance-block {
    align-items: flex-end;
}

.topbar-actions {
    flex-direction: row;
    align-items: center;
}

.topbar-settings-button {
    height: 30px;
    margin-right: 18px;
    padding-left: 13px;
    padding-right: 13px;
    color: var(--text-soft);
    background-color: transparent;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
}

.topbar-settings-button:hover {
    color: var(--text);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.eyebrow,
.rail-title,
.stats-title,
.mission-kicker {
    color: var(--text-soft);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
}

.balance-value {
    margin-top: 2px;
    color: var(--text);
    font-size: 18px;
    -unity-font-style: bold;
}

.tabbar {
    height: 58px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 22px;
    background-color: rgba(12, 15, 19, 0.96);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.top-tab {
    height: 34px;
    margin-right: 8px;
    padding-left: 18px;
    padding-right: 18px;
    color: var(--text-soft);
    background-color: var(--panel-soft);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 17px;
    border-top-right-radius: 17px;
    border-bottom-left-radius: 17px;
    border-bottom-right-radius: 17px;
    -unity-font-style: bold;
}

.top-tab:hover {
    color: var(--text);
    background-color: var(--panel-hover);
}

.top-tab--selected {
    color: rgb(8, 13, 18);
    background-color: var(--accent);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.content-row {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
}

.rail {
    width: 265px;
    flex-shrink: 0;
    padding: 22px 18px 18px 18px;
    background-color: var(--panel-bg);
}

.left-rail {
    border-right-width: 1px;
    border-right-color: var(--border);
}

.right-rail {
    width: 310px;
    border-left-width: 1px;
    border-left-color: var(--border);
}

.rail-title {
    margin-bottom: 14px;
}

.rail-list,
.right-list {
    flex-grow: 1;
}

.rail-item {
    height: 42px;
    margin-bottom: 7px;
    padding-left: 14px;
    padding-right: 14px;
    -unity-text-align: middle-left;
    color: var(--text-soft);
    background-color: rgba(255, 255, 255, 0.035);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.rail-item:hover {
    color: var(--text);
    background-color: var(--panel-hover);
    border-left-color: var(--border-strong);
    border-right-color: var(--border-strong);
    border-top-color: var(--border-strong);
    border-bottom-color: var(--border-strong);
}

.rail-item--selected {
    color: rgb(8, 13, 18);
    background-color: var(--accent);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.filter-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.filter-chip {
    height: 29px;
    margin-right: 5px;
    margin-bottom: 5px;
    padding-left: 9px;
    padding-right: 9px;
    color: var(--text-dim);
    background-color: transparent;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    font-size: 10px;
}

.filter-chip--selected {
    color: var(--text);
    background-color: var(--accent-soft);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.center-stage {
    position: relative;
    flex-grow: 1;
    min-width: 0;
}

.stage-context {
    position: absolute;
    left: 24px;
    top: 18px;
    color: var(--text-soft);
    font-size: 13px;
    letter-spacing: 0.3px;
}

.preview-viewport {
    flex-grow: 1;
    min-height: 280px;
}

.drag-hint {
    position: absolute;
    right: 22px;
    top: 17px;
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    background-color: rgba(8, 11, 14, 0.62);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.drag-icon {
    margin-right: 6px;
    color: var(--accent);
}

.drag-copy {
    color: var(--text-dim);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
}

.stats-panel {
    min-height: 188px;
    margin: 0 18px 16px 18px;
    padding: 15px 16px 14px 16px;
    background-color: rgba(13, 17, 21, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.stats-heading-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.stats-title {
    color: var(--text);
    font-size: 12px;
}

.stats-subtitle {
    margin-top: 3px;
    color: var(--text-dim);
    font-size: 10px;
}

.live-badge {
    padding: 5px 8px;
    color: var(--accent);
    background-color: var(--accent-soft);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
}

.stat-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.stat-card {
    min-width: 145px;
    flex-grow: 1;
    margin-right: 8px;
    margin-bottom: 8px;
    padding: 10px;
    background-color: rgba(255, 255, 255, 0.035);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.stat-name {
    color: var(--text-dim);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.7px;
}

.stat-value-row {
    height: 23px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.stat-value {
    color: var(--text);
    font-size: 11px;
    -unity-font-style: bold;
}

.stat-delta {
    color: var(--text-dim);
    font-size: 10px;
    -unity-font-style: bold;
}

.stat-positive {
    color: var(--positive);
}

.stat-negative {
    color: var(--negative);
}

.stat-track {
    position: relative;
    height: 6px;
    margin-top: 5px;
    background-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    overflow: hidden;
}

.stat-current-fill,
.stat-preview-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(165, 178, 189, 0.48);
    transition-property: width, background-color;
    transition-duration: 0.16s;
}

.stat-preview-fill {
    height: 2px;
    top: auto;
    bottom: 0;
    background-color: var(--accent);
}

.stat-preview-fill--positive {
    background-color: var(--positive);
}

.stat-preview-fill--negative {
    background-color: var(--negative);
}

.slot-row {
    min-height: 78px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.slot-copy {
    flex-grow: 1;
}

.slot-label {
    color: var(--text-dim);
    font-size: 10px;
}

.slot-value {
    margin-top: 3px;
    color: var(--text);
    font-size: 13px;
    -unity-font-style: bold;
}

.slot-effect {
    max-width: 190px;
    margin-top: 3px;
    color: var(--text-dim);
    font-size: 9px;
    white-space: normal;
}

.slot-actions {
    flex-shrink: 0;
    align-items: flex-end;
}

.ghost-button {
    color: var(--text-soft);
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    font-size: 10px;
    -unity-font-style: bold;
}

.ghost-button:hover {
    color: var(--accent);
}

.ghost-button--danger {
    color: rgba(255, 102, 111, 0.72);
}

.ghost-button--danger:hover {
    color: var(--negative);
}

.detail-block {
    flex-shrink: 0;
    margin-top: 14px;
    padding-top: 16px;
    border-top-width: 1px;
    border-top-color: var(--border);
}

.detail-title {
    color: var(--text);
    font-size: 18px;
    -unity-font-style: bold;
}

.detail-description {
    min-height: 46px;
    margin-top: 7px;
    margin-bottom: 12px;
    color: var(--text-soft);
    font-size: 11px;
    white-space: normal;
}

.detail-mechanics {
    margin-bottom: 12px;
    padding: 10px 11px;
    background-color: rgba(255, 255, 255, 0.035);
    border-left-width: 2px;
    border-left-color: var(--accent);
    border-top-left-radius: 4px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 7px;
}

.detail-mechanic-kicker {
    color: var(--accent);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
}

.detail-mechanic-kicker--tradeoff {
    margin-top: 8px;
    color: var(--negative);
}

.detail-effect,
.detail-tradeoff {
    margin-top: 3px;
    color: var(--text-soft);
    font-size: 10px;
    white-space: normal;
}

.primary-action,
.mission-button {
    height: 40px;
    color: rgb(8, 13, 18);
    background-color: var(--accent);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    -unity-font-style: bold;
    letter-spacing: 0.4px;
}

.primary-action:disabled,
.mission-button:disabled {
    color: var(--text-dim);
    background-color: rgba(255, 255, 255, 0.06);
}

.context-hint {
    margin-top: 7px;
    color: var(--text-dim);
    font-size: 9px;
    white-space: normal;
}

.footerbar {
    height: 82px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 24px;
    padding-right: 22px;
    background-color: var(--garage-bg);
    border-top-width: 1px;
    border-top-color: var(--border);
}

.selected-build {
    color: var(--text-soft);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.35px;
}

.footer-mission-brief {
    flex-grow: 1;
    min-width: 0;
}

.mission-brief-row {
    margin-top: 8px;
    flex-direction: row;
    align-items: center;
}

.mission-brief-value,
.mission-brief-control {
    margin-right: 14px;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.65px;
}

.mission-brief-value {
    color: var(--accent);
}

.mission-brief-control {
    color: var(--text-dim);
}

.mission-button {
    min-width: 190px;
    padding-left: 18px;
    padding-right: 18px;
}

/* Vehicle-first Safehouse Garage */
.garage-root {
    --garage-bg: rgba(22, 31, 36, 0.94);
    --panel-bg: rgba(36, 47, 52, 0.94);
    --panel-soft: rgba(48, 60, 65, 0.92);
    --panel-hover: rgba(66, 79, 84, 0.98);
    --border: rgba(255, 246, 225, 0.18);
    --border-strong: rgba(255, 246, 225, 0.34);
    --text: rgb(255, 249, 235);
    --text-soft: rgb(213, 211, 201);
    --text-dim: rgb(163, 167, 163);
    --accent: rgb(255, 181, 47);
    --accent-soft: rgba(255, 181, 47, 0.00);
    --positive: rgb(105, 218, 155);
    --negative: rgb(255, 107, 91);
    background-color: transparent;
}

.garage-root .topbar {
    height: 72px;
    padding-left: 26px;
    padding-right: 22px;
    background-color: rgba(22, 31, 36, 0.96);
    border-bottom-color: rgba(255, 246, 225, 0.14);
}

.garage-root .brand-mark {
    margin-right: 10px;
    color: var(--accent);
    font-size: 13px;
}

.garage-root .brand-title {
    font-size: 17px;
    letter-spacing: 1.4px;
}

.garage-root .tabbar {
    height: 72px;
    flex-grow: 1;
    justify-content: center;
    padding-left: 40px;
    padding-right: 40px;
    background-color: transparent;
    border-bottom-width: 0;
}

.garage-root .top-tab {
    height: 72px;
    margin-left: 17px;
    margin-right: 17px;
    padding-left: 0;
    padding-right: 0;
    color: rgb(183, 185, 179);
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    font-size: 12px;
    letter-spacing: 1.0px;
}

.garage-root .top-tab:hover {
    color: var(--text);
    background-color: transparent;
}

.garage-root .top-tab--selected {
    color: var(--accent);
    background-color: transparent;
    border-bottom-color: var(--accent);
}

.garage-root .topbar-actions {
    min-width: 145px;
    justify-content: flex-end;
}

.garage-root .balance-block {
    align-items: flex-end;
}

.garage-root .balance-value {
    margin-top: 0;
    color: var(--text);
    font-size: 16px;
    letter-spacing: 0.6px;
}

.garage-root .topbar-settings-button {
    width: 36px;
    height: 36px;
    margin-left: 15px;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
    color: var(--text-soft);
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    font-size: 17px;
}

.garage-root .topbar-settings-button:hover {
    color: var(--text);
    background-color: rgba(255, 255, 255, 0.08);
}

.garage-root .content-row {
    position: relative;
    flex-grow: 1;
    min-height: 0;
    background-color: rgba(88, 103, 108, 0.13);
}

.garage-root .center-stage {
    position: relative;
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
}

.garage-root .stage-context {
    left: 26px;
    top: 19px;
    color: rgba(228, 225, 214, 0.86);
    font-size: 12px;
    letter-spacing: 0.45px;
}

.garage-root .preview-viewport {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    min-height: 0;
}

.garage-root .drag-hint {
    right: 24px;
    top: 17px;
    padding: 7px 10px;
    background-color: rgba(36, 47, 52, 0.90);
    border-top-left-radius: 13px;
    border-top-right-radius: 13px;
    border-bottom-left-radius: 13px;
    border-bottom-right-radius: 13px;
}

.garage-root .drag-icon {
    color: var(--accent);
}

.garage-root .drag-copy {
    color: rgba(213, 211, 201, 0.82);
    font-size: 10px;
    letter-spacing: 0.75px;
}

.browser-drawer,
.context-drawer,
.garage-root .stats-panel {
    background-color: rgba(36, 47, 52, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 246, 225, 0.18);
    border-right-color: rgba(255, 246, 225, 0.18);
    border-top-color: rgba(255, 246, 225, 0.18);
    border-bottom-color: rgba(255, 246, 225, 0.18);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

.browser-drawer {
    position: absolute;
    left: 24px;
    top: 68px;
    width: 336px;
    max-height: 430px;
    padding: 18px 16px 14px 16px;
}

.garage-root .rail-title {
    margin-left: 4px;
    margin-bottom: 14px;
    color: rgb(190, 191, 184);
    font-size: 11px;
    letter-spacing: 1.15px;
}

.garage-root .rail-list {
    flex-grow: 0;
    max-height: 374px;
}

.garage-root .rail-item {
    height: 55px;
    margin-bottom: 6px;
    padding-left: 15px;
    padding-right: 14px;
    color: rgb(217, 214, 204);
    background-color: rgba(255, 255, 255, 0.035);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
    -unity-text-align: middle-left;
}

.garage-root .rail-item-copy {
    flex-grow: 1;
    min-width: 0;
    justify-content: center;
}

.garage-root .rail-item-title {
    color: var(--text);
    font-size: 14px;
    -unity-font-style: bold;
    white-space: nowrap;
}

.garage-root .rail-item-meta {
    margin-top: 3px;
    color: var(--text-dim);
    font-size: 10px;
    letter-spacing: 0.75px;
}

.garage-root .rail-item:hover {
    color: var(--text);
    background-color: rgba(255, 255, 255, 0.08);
}

.garage-root .rail-item--selected {
    color: var(--accent);
    background-color: transparent;
    border-left-width: 3px;
    border-left-color: var(--accent);
}

.garage-root .rail-item--selected .rail-item-title {
    color: var(--text);
}

.garage-root .rail-item--selected .rail-item-meta {
    color: var(--accent);
}

.garage-root .filter-row {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin-bottom: 0;
}

.garage-root .filter-chip {
    position: absolute;
    width: 54px;
    height: 54px;
    margin-right: 0;
    margin-bottom: 0;
    padding-left: 2px;
    padding-right: 2px;
    color: var(--text-soft);
    background-color: rgba(36, 47, 52, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 246, 225, 0.46);
    border-right-color: rgba(255, 246, 225, 0.46);
    border-top-color: rgba(255, 246, 225, 0.46);
    border-bottom-color: rgba(255, 246, 225, 0.46);
    border-top-left-radius: 27px;
    border-top-right-radius: 27px;
    border-bottom-left-radius: 27px;
    border-bottom-right-radius: 27px;
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 0.35px;
    translate: -50% -50%;
}

.garage-root .filter-chip:hover {
    color: var(--text);
    background-color: var(--panel-hover);
    border-left-color: rgba(255, 246, 225, 0.82);
    border-right-color: rgba(255, 246, 225, 0.82);
    border-top-color: rgba(255, 246, 225, 0.82);
    border-bottom-color: rgba(255, 246, 225, 0.82);
}

.garage-root .filter-chip--selected {
    color: var(--accent);
    background-color: transparent;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.garage-root .stats-panel {
    position: absolute;
    left: 24px;
    bottom: 24px;
    width: 332px;
    min-height: 0;
    margin: 0;
    padding: 18px 19px 15px 19px;
}

.garage-root .stats-title {
    margin-bottom: 10px;
    color: rgb(194, 194, 187);
    font-size: 11px;
    letter-spacing: 1.2px;
}

.garage-root .stat-grid {
    flex-direction: column;
    flex-wrap: nowrap;
}

.garage-root .stat-card {
    min-width: 0;
    height: 48px;
    flex-grow: 0;
    margin-right: 0;
    margin-bottom: 2px;
    padding: 0;
    background-color: transparent;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 246, 225, 0.10);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.garage-root .stat-name {
    color: rgb(178, 181, 177);
    font-size: 10px;
    letter-spacing: 0.8px;
}

.garage-root .stat-value-row {
    height: 22px;
}

.garage-root .stat-value {
    color: var(--text);
    font-size: 13px;
}

.garage-root .stat-delta {
    font-size: 12px;
}

.garage-root .stat-track {
    height: 3px;
    margin-top: 3px;
    background-color: rgba(255, 246, 225, 0.14);
    border-top-left-radius: 1px;
    border-top-right-radius: 1px;
    border-bottom-left-radius: 1px;
    border-bottom-right-radius: 1px;
}

.garage-root .stat-current-fill,
.garage-root .stat-preview-fill {
    background-color: rgba(255, 221, 144, 0.58);
}

.garage-root .stat-preview-fill {
    height: 3px;
    background-color: rgb(255, 181, 47);
}

.context-drawer {
    position: absolute;
    right: 24px;
    top: 68px;
    width: 368px;
    max-height: 430px;
    padding: 18px 18px 15px 18px;
}

.garage-root .right-list {
    flex-grow: 0;
    max-height: 356px;
}

.garage-root .slot-row {
    min-height: 58px;
    padding-top: 7px;
    padding-bottom: 7px;
    border-bottom-color: rgba(238, 231, 220, 0.08);
}

.garage-root .slot-label {
    font-size: 10px;
    letter-spacing: 0.7px;
}

.garage-root .slot-value {
    margin-top: 3px;
    font-size: 14px;
}

.garage-root .slot-effect {
    display: none;
}

.garage-root .ghost-button {
    padding-left: 8px;
    padding-right: 8px;
    font-size: 11px;
}

.garage-root .ghost-button:hover {
    color: rgb(226, 105, 87);
}

.garage-screen--assembly .context-drawer .detail-block {
    display: none;
}

.garage-screen--gallery .context-drawer,
.garage-screen--parts .context-drawer {
    left: 50%;
    right: auto;
    top: auto;
    bottom: 24px;
    width: 960px;
    max-height: 194px;
    padding: 18px 22px 17px 22px;
    translate: -50% 0;
    background-color: rgba(36, 47, 52, 0.97);
    border-top-width: 2px;
    border-top-color: var(--accent);
}

.garage-screen--gallery .right-list,
.garage-screen--parts .right-list {
    display: none;
}

.garage-screen--gallery .context-drawer-title,
.garage-screen--parts .context-drawer-title {
    display: flex;
    margin-left: 0;
    margin-bottom: 11px;
    color: rgb(199, 199, 191);
}

.garage-root .detail-block {
    margin-top: 0;
    padding-top: 0;
    flex-direction: row;
    align-items: center;
    border-top-width: 0;
}

.garage-root .detail-copy {
    flex-grow: 1;
    min-width: 0;
    padding-right: 28px;
}

.garage-root .detail-title {
    color: var(--text);
    font-size: 24px;
    letter-spacing: 0.35px;
}

.garage-root .detail-description {
    min-height: 0;
    margin-top: 6px;
    margin-bottom: 7px;
    color: var(--text-soft);
    font-size: 12px;
    white-space: normal;
}

.garage-root .detail-mechanics {
    margin-bottom: 0;
    padding: 0;
    flex-direction: row;
    background-color: transparent;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.garage-root .detail-mechanic-kicker {
    display: none;
}

.garage-root .detail-effect,
.garage-root .detail-tradeoff {
    max-width: 48%;
    margin-top: 4px;
    margin-right: 18px;
    color: var(--text-soft);
    font-size: 11px;
    white-space: normal;
}

.garage-root .detail-effect {
    color: rgb(122, 202, 157);
}

.garage-root .detail-tradeoff {
    color: rgb(213, 119, 112);
}

.garage-root .detail-action-block {
    width: 268px;
    flex-shrink: 0;
    padding-left: 22px;
    border-left-width: 1px;
    border-left-color: rgba(255, 246, 225, 0.16);
}

.garage-root .primary-action,
.garage-root .mission-button {
    height: 52px;
    color: rgb(255, 252, 241);
    background-color: rgb(239, 91, 42);
    border-top-left-radius: 13px;
    border-top-right-radius: 13px;
    border-bottom-left-radius: 13px;
    border-bottom-right-radius: 13px;
    font-size: 12px;
    letter-spacing: 0.75px;
}

.garage-root .primary-action:hover,
.garage-root .mission-button:hover {
    background-color: rgb(255, 116, 45);
}

.garage-root .primary-action:disabled,
.garage-root .mission-button:disabled {
    color: rgb(147, 153, 151);
    background-color: rgba(255, 255, 255, 0.08);
}

.garage-root .context-hint {
    margin-top: 7px;
    color: var(--text-dim);
    font-size: 10px;
    -unity-text-align: upper-center;
}

.garage-root .footerbar {
    position: relative;
    height: 82px;
    padding-left: 25px;
    padding-right: 25px;
    background-color: rgba(22, 31, 36, 0.96);
    border-top-color: rgba(255, 246, 225, 0.14);
}

.garage-root .selected-build {
    color: rgb(175, 170, 161);
    font-size: 12px;
    letter-spacing: 0.45px;
}

.garage-root .mission-brief-row {
    margin-top: 7px;
}

.garage-root .mission-brief-value,
.garage-root .mission-brief-control {
    margin-right: 13px;
    font-size: 10px;
}

.garage-root .mission-brief-value {
    color: var(--accent);
}

.garage-root .mission-button {
    position: absolute;
    left: 50%;
    top: 15px;
    width: 268px;
    min-width: 268px;
    translate: -50% 0;
}

.garage-root .footer-mission-brief {
    max-width: 610px;
}

.garage-root .rail-list .unity-scroll-view__vertical-scroller,
.garage-root .rail-list .unity-scroll-view__horizontal-scroller,
.garage-root .right-list .unity-scroll-view__vertical-scroller,
.garage-root .right-list .unity-scroll-view__horizontal-scroller {
    display: none;
}

.garage-root .empty-state {
    padding: 14px 12px;
    color: rgb(151, 147, 140);
    font-size: 11px;
    white-space: normal;
}

/* Two-screen showroom: the vehicle owns the stage, controls stay spatial. */
.garage-root .showroom-arrow {
    position: absolute;
    top: 45%;
    width: 68px;
    height: 68px;
    padding: 0;
    color: var(--text);
    background-color: rgba(42, 55, 61, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 246, 225, 0.28);
    border-right-color: rgba(255, 246, 225, 0.28);
    border-top-color: rgba(255, 246, 225, 0.28);
    border-bottom-color: rgba(255, 246, 225, 0.28);
    border-top-left-radius: 34px;
    border-top-right-radius: 34px;
    border-bottom-left-radius: 34px;
    border-bottom-right-radius: 34px;
    font-size: 42px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    translate: 0 -50%;
}

.garage-root .showroom-arrow:hover {
    color: rgb(40, 37, 28);
    background-color: var(--accent);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.garage-root .showroom-arrow:disabled {
    opacity: 0.28;
}

.garage-root .showroom-arrow--left {
    left: 29%;
}

.garage-root .showroom-arrow--right {
    right: 29%;
}

.garage-root .showroom-caption {
    position: absolute;
    left: 50%;
    bottom: 221px;
    min-width: 230px;
    align-items: center;
    translate: -50% 0;
}

.garage-root .showroom-caption-title {
    color: var(--text);
    font-size: 12px;
    letter-spacing: 1.25px;
}

.garage-root .showroom-caption-meta {
    margin-top: 5px;
    color: var(--accent);
    font-size: 10px;
    letter-spacing: 0.95px;
}

.garage-root .stats-panel {
    left: 26px;
    top: 50%;
    bottom: auto;
    width: 326px;
    padding: 17px 18px 15px 18px;
    translate: 0 -50%;
    background-color: rgba(36, 47, 52, 0.90);
    border-left-color: rgba(255, 246, 225, 0.16);
    border-right-color: rgba(255, 246, 225, 0.16);
    border-top-color: rgba(255, 246, 225, 0.16);
    border-bottom-color: rgba(255, 246, 225, 0.16);
}

.garage-root .stats-title {
    margin-bottom: 7px;
    color: rgb(196, 197, 190);
    font-size: 10px;
    letter-spacing: 1.25px;
}

.garage-root .stat-card {
    height: 45px;
    margin-bottom: 0;
    flex-direction: row;
    align-items: center;
    border-bottom-color: rgba(255, 246, 225, 0.11);
}

.garage-root .stat-name {
    width: 88px;
    flex-shrink: 0;
    color: rgb(180, 183, 179);
    font-size: 10px;
    letter-spacing: 0.75px;
}

.garage-root .stat-value-row {
    height: 45px;
    flex-grow: 1;
    justify-content: flex-end;
    align-items: center;
}

.garage-root .stat-value {
    flex-grow: 1;
    color: var(--text);
    font-size: 13px;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.garage-root .stat-delta {
    min-width: 62px;
    margin-left: 8px;
    font-size: 12px;
    white-space: nowrap;
    -unity-text-align: middle-right;
}

/* Readable performance rows with a passive value slider beneath the text. */
.garage-root .stats-panel {
    width: 344px;
    padding: 17px 18px 14px 18px;
}

.garage-root .stat-card {
    height: 54px;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
}

.garage-root .stat-header {
    height: 31px;
    flex-direction: row;
    align-items: center;
}

.garage-root .stat-value-row {
    height: 31px;
}

.garage-root .stat-track {
    position: relative;
    width: 100%;
    height: 5px;
    margin-top: 1px;
    margin-bottom: 7px;
    background-color: rgba(255, 246, 225, 0.14);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    overflow: hidden;
}

.garage-root .stat-current-fill,
.garage-root .stat-preview-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(255, 221, 144, 0.52);
}

.garage-root .stat-preview-fill {
    top: auto;
    bottom: 0;
    height: 2px;
    background-color: var(--accent);
}

.garage-root .stat-preview-fill--positive {
    background-color: rgb(98, 190, 137);
}

.garage-root .stat-preview-fill--negative {
    background-color: rgb(218, 83, 88);
}

/* Keep carousel identity above the vehicle instead of over the model. */
.garage-root .showroom-caption {
    left: 50%;
    top: 17px;
    bottom: auto;
    min-width: 270px;
    height: 40px;
    padding-left: 16px;
    padding-right: 16px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    translate: -50% 0;
    background-color: rgba(36, 47, 52, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 2px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 246, 225, 0.18);
    border-right-color: rgba(255, 246, 225, 0.18);
    border-top-color: var(--accent);
    border-bottom-color: rgba(255, 246, 225, 0.18);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}

.garage-root .showroom-caption-title {
    color: var(--text);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.15px;
}

.garage-root .showroom-caption-meta {
    margin-top: 0;
    margin-left: 13px;
    padding-left: 13px;
    color: var(--accent);
    font-size: 10px;
    letter-spacing: 0.9px;
    border-left-width: 1px;
    border-left-color: rgba(255, 246, 225, 0.20);
}

.garage-screen--gallery .context-drawer,
.garage-screen--parts .context-drawer {
    bottom: 18px;
    width: 58%;
    min-width: 720px;
    max-width: 940px;
    min-height: 116px;
    max-height: 126px;
    padding: 15px 18px 14px 20px;
}

.garage-root .detail-copy {
    padding-right: 24px;
}

.garage-root .detail-title {
    font-size: 23px;
}

.garage-root .detail-description {
    max-height: 34px;
    margin-top: 5px;
    margin-bottom: 0;
    color: var(--text-soft);
    font-size: 12px;
    overflow: hidden;
}

.garage-screen--parts .detail-mechanics {
    display: none;
}

.garage-root .detail-action-block {
    width: 252px;
    padding-left: 18px;
}

.garage-root .primary-action {
    height: 48px;
}

.garage-root .context-hint {
    margin-top: 7px;
    color: var(--text-dim);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
    -unity-text-align: middle-center;
}

.garage-root .footerbar {
    height: 76px;
    padding-left: 0;
    padding-right: 0;
}

.garage-root .mission-button {
    top: 12px;
}

/* Light arcade garage: selection is typographic, never a colored wash or strip. */
.garage-root {
    --garage-bg: rgba(239, 235, 221, 0.98);
    --panel-bg: rgba(250, 247, 237, 0.97);
    --panel-soft: rgba(231, 226, 210, 0.97);
    --panel-hover: rgba(220, 214, 196, 0.99);
    --border: rgba(38, 45, 46, 0.18);
    --border-strong: rgba(38, 45, 46, 0.34);
    --text: rgb(34, 39, 40);
    --text-soft: rgb(75, 80, 79);
    --text-dim: rgb(111, 113, 106);
    --accent: rgb(232, 91, 48);
    --accent-soft: rgba(232, 91, 48, 0.00);
    --positive: rgb(42, 139, 87);
    --negative: rgb(198, 62, 57);
}

.garage-root .topbar,
.garage-root .footerbar {
    background-color: rgba(239, 235, 221, 0.98);
    border-color: rgba(38, 45, 46, 0.16);
}

.garage-root .brand-mark,
.garage-root .drag-icon {
    color: var(--accent);
}

.garage-root .brand-title,
.garage-root .balance-value {
    color: var(--text);
}

.garage-root .top-tab,
.garage-root .top-tab:hover,
.garage-root .top-tab:active,
.garage-root .top-tab--selected {
    color: rgb(102, 104, 98);
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.garage-root .top-tab:hover {
    color: rgb(54, 59, 59);
}

.garage-root .top-tab--selected {
    color: rgb(28, 33, 34);
    -unity-font-style: bold;
}

.garage-root .topbar-settings-button {
    color: var(--text-soft);
}

.garage-root .topbar-settings-button:hover {
    color: var(--text);
    background-color: rgba(38, 45, 46, 0.08);
}

.garage-root .content-row {
    background-color: rgba(248, 245, 233, 0.08);
}

.garage-root .stage-context {
    color: rgba(51, 57, 57, 0.82);
}

.garage-root .drag-hint {
    background-color: rgba(250, 247, 237, 0.91);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(38, 45, 46, 0.16);
}

.garage-root .drag-copy {
    color: var(--text-soft);
}

.browser-drawer,
.context-drawer,
.garage-root .stats-panel,
.garage-root .showroom-caption {
    color: var(--text);
    background-color: rgba(250, 247, 237, 0.96);
    border-left-color: rgba(38, 45, 46, 0.20);
    border-right-color: rgba(38, 45, 46, 0.20);
    border-top-color: rgba(38, 45, 46, 0.20);
    border-bottom-color: rgba(38, 45, 46, 0.20);
}

.garage-screen--gallery .context-drawer,
.garage-screen--parts .context-drawer {
    background-color: rgba(250, 247, 237, 0.97);
    border-top-width: 1px;
    border-top-color: rgba(38, 45, 46, 0.22);
}

.garage-root .rail-title,
.garage-root .stats-title,
.garage-screen--gallery .context-drawer-title,
.garage-screen--parts .context-drawer-title {
    color: var(--text-soft);
}

.garage-root .rail-item {
    color: var(--text-soft);
    background-color: rgba(38, 45, 46, 0.035);
}

.garage-root .rail-item:hover {
    color: var(--text);
    background-color: rgba(38, 45, 46, 0.075);
}

.garage-root .rail-item--selected,
.garage-root .rail-item--selected:hover {
    color: var(--text);
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    -unity-font-style: bold;
}

.garage-root .rail-item-title,
.garage-root .rail-item--selected .rail-item-title {
    color: var(--text);
}

.garage-root .rail-item-meta,
.garage-root .rail-item--selected .rail-item-meta {
    color: var(--text-dim);
}

.garage-root .filter-chip {
    color: var(--text-soft);
    background-color: rgba(250, 247, 237, 0.96);
    border-left-color: rgba(38, 45, 46, 0.32);
    border-right-color: rgba(38, 45, 46, 0.32);
    border-top-color: rgba(38, 45, 46, 0.32);
    border-bottom-color: rgba(38, 45, 46, 0.32);
}

.garage-root .filter-chip:hover {
    color: var(--text);
    background-color: rgba(235, 230, 215, 0.98);
    border-left-color: rgba(38, 45, 46, 0.52);
    border-right-color: rgba(38, 45, 46, 0.52);
    border-top-color: rgba(38, 45, 46, 0.52);
    border-bottom-color: rgba(38, 45, 46, 0.52);
}

.garage-root .filter-chip--selected,
.garage-root .filter-chip--selected:hover {
    color: rgb(24, 29, 30);
    background-color: rgba(250, 247, 237, 0.98);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(48, 55, 55);
    border-right-color: rgb(48, 55, 55);
    border-top-color: rgb(48, 55, 55);
    border-bottom-color: rgb(48, 55, 55);
}

.garage-root .stat-card,
.garage-root .slot-row {
    border-bottom-color: rgba(38, 45, 46, 0.11);
}

.garage-root .stat-name,
.garage-root .slot-label {
    color: var(--text-dim);
}

.garage-root .stat-value,
.garage-root .slot-value,
.garage-root .detail-title,
.garage-root .showroom-caption-title {
    color: var(--text);
}

.garage-root .detail-description,
.garage-root .detail-effect,
.garage-root .detail-tradeoff,
.garage-root .context-hint,
.garage-root .selected-build {
    color: var(--text-soft);
}

.garage-root .detail-effect {
    color: var(--positive);
}

.garage-root .detail-tradeoff {
    color: var(--negative);
}

.garage-root .detail-action-block {
    border-left-color: rgba(38, 45, 46, 0.16);
}

.garage-root .stat-track {
    background-color: rgba(38, 45, 46, 0.15);
}

.garage-root .stat-current-fill,
.garage-root .stat-preview-fill {
    background-color: rgba(76, 84, 81, 0.58);
}

.garage-root .stat-preview-fill--positive {
    background-color: var(--positive);
}

.garage-root .stat-preview-fill--negative {
    background-color: var(--negative);
}

.garage-root .showroom-caption {
    border-top-width: 1px;
}

.garage-root .showroom-caption-meta {
    color: var(--text-dim);
    border-left-color: rgba(38, 45, 46, 0.17);
}

.garage-root .showroom-arrow {
    color: var(--text);
    background-color: rgba(250, 247, 237, 0.94);
    border-left-color: rgba(38, 45, 46, 0.30);
    border-right-color: rgba(38, 45, 46, 0.30);
    border-top-color: rgba(38, 45, 46, 0.30);
    border-bottom-color: rgba(38, 45, 46, 0.30);
}

.garage-root .showroom-arrow:hover {
    color: rgb(23, 28, 29);
    background-color: rgba(220, 214, 196, 0.98);
    border-left-color: rgba(38, 45, 46, 0.52);
    border-right-color: rgba(38, 45, 46, 0.52);
    border-top-color: rgba(38, 45, 46, 0.52);
    border-bottom-color: rgba(38, 45, 46, 0.52);
}

.garage-root .primary-action,
.garage-root .mission-button {
    color: rgb(255, 252, 244);
    background-color: rgb(232, 91, 48);
}

.garage-root .primary-action:hover,
.garage-root .mission-button:hover {
    background-color: rgb(247, 108, 54);
}

.garage-root .primary-action:disabled,
.garage-root .mission-button:disabled {
    color: rgb(132, 133, 126);
    background-color: rgb(218, 214, 200);
}

.garage-root .mission-brief-value {
    color: var(--accent);
}

.garage-root .mission-brief-control,
.garage-root .empty-state {
    color: var(--text-dim);
}

.mission-hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    pointer-events: none;
}

.mission-top-anchor {
    position: absolute;
    left: 0;
    right: 0;
    top: 18px;
    align-items: center;
}

.mission-top-row {
    width: 570px;
    height: 64px;
    flex-direction: row;
    align-items: center;
    padding: 0 5px;
    background-color: rgba(8, 11, 14, 0.88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 2px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.12);
    border-right-color: rgba(255, 255, 255, 0.12);
    border-top-color: rgba(103, 186, 255, 0.78);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.mission-hud-segment {
    height: 60px;
    padding: 7px 15px;
    justify-content: center;
}

.mission-objective-card {
    width: 216px;
}

.mission-timer-card {
    width: 126px;
    align-items: center;
}

.mission-score-card {
    width: 216px;
}

.mission-strip-divider {
    width: 1px;
    height: 33px;
    flex-shrink: 0;
    background-color: rgba(255, 255, 255, 0.12);
}

.mission-primary-value {
    margin-top: 1px;
    color: var(--text);
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 0.55px;
    transform-origin: 50% 50%;
}

.mission-timer {
    margin-top: 1px;
    color: var(--text);
    font-size: 25px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
}

.mission-objective-card--complete {
    background-color: rgba(42, 112, 76, 0.24);
}

.mission-telemetry-stack {
    position: absolute;
    left: 20px;
    bottom: 20px;
    width: 396px;
}

.mission-vehicle-panel {
    position: relative;
    width: 396px;
    height: 170px;
    flex-direction: row;
    align-items: flex-end;
    background-color: transparent;
}

.mission-speedometer {
    position: relative;
    width: 166px;
    height: 166px;
    flex-shrink: 0;
    background-color: rgba(7, 10, 13, 0.70);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(132, 197, 240, 0.13);
    border-right-color: rgba(132, 197, 240, 0.13);
    border-top-color: rgba(132, 197, 240, 0.13);
    border-bottom-color: rgba(132, 197, 240, 0.13);
    border-top-left-radius: 83px;
    border-top-right-radius: 83px;
    border-bottom-left-radius: 83px;
    border-bottom-right-radius: 83px;
}

.mission-speed-tick,
.mission-speed-needle {
    position: absolute;
    left: 0;
    top: 0;
    width: 164px;
    height: 164px;
    transform-origin: 50% 50%;
}

.mission-speed-tick-mark {
    position: absolute;
    left: 81px;
    top: 9px;
    width: 2px;
    height: 10px;
    background-color: rgba(184, 211, 229, 0.40);
    border-top-left-radius: 1px;
    border-top-right-radius: 1px;
    border-bottom-left-radius: 1px;
    border-bottom-right-radius: 1px;
}

.speed-tick--0 { rotate: -120deg; }
.speed-tick--1 { rotate: -100deg; }
.speed-tick--2 { rotate: -80deg; }
.speed-tick--3 { rotate: -60deg; }
.speed-tick--4 { rotate: -40deg; }
.speed-tick--5 { rotate: -20deg; }
.speed-tick--6 { rotate: 0deg; }
.speed-tick--7 { rotate: 20deg; }
.speed-tick--8 { rotate: 40deg; }
.speed-tick--9 { rotate: 60deg; }
.speed-tick--10 { rotate: 80deg; }
.speed-tick--11 { rotate: 100deg; }
.speed-tick--12 { rotate: 120deg; }

.mission-speed-needle {
    rotate: -120deg;
}

.mission-speed-needle-bar {
    position: absolute;
    left: 80px;
    top: 25px;
    width: 3px;
    height: 59px;
    background-color: rgb(106, 194, 255);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
}

.mission-speed-hub {
    position: absolute;
    left: 77px;
    top: 77px;
    width: 10px;
    height: 10px;
    background-color: rgb(213, 234, 247);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.mission-current-speed {
    position: absolute;
    left: 0;
    right: 0;
    top: 61px;
    color: var(--text);
    font-size: 45px;
    -unity-font-style: bold;
    letter-spacing: -1.5px;
    -unity-text-align: middle-center;
}

.mission-speed-unit {
    position: absolute;
    left: 0;
    right: 0;
    top: 112px;
    color: rgba(247, 240, 226, 0.78);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.6px;
    -unity-text-align: middle-center;
}

.mission-speedometer--fast .mission-speed-needle-bar {
    background-color: rgb(255, 173, 61);
}

.mission-run-status {
    width: 218px;
    min-height: 135px;
    margin-left: 12px;
    margin-bottom: 8px;
    padding-left: 13px;
    justify-content: flex-end;
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.15);
    transition-property: background-color, border-left-color;
    transition-duration: 0.12s;
}

.mission-run-status--damage {
    background-color: rgba(255, 54, 63, 0.08);
    border-left-color: rgba(255, 86, 91, 0.92);
}

.mission-vehicle-name {
    margin-bottom: 10px;
    color: rgb(247, 240, 226);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1.1px;
}

.mission-health-copy {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.mission-health-tag {
    color: rgb(106, 194, 255);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    transition-property: color;
    transition-duration: 0.1s;
}

.mission-health-value {
    color: rgb(247, 240, 226);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0.45px;
    transition-property: color;
    transition-duration: 0.1s;
}

.mission-run-status--damage .mission-health-tag,
.mission-run-status--damage .mission-health-value {
    color: rgb(255, 104, 109);
}

.mission-health-segments {
    height: 9px;
    margin-top: 7px;
    flex-direction: row;
}

.mission-health-segment {
    height: 9px;
    flex-grow: 1;
    margin-right: 3px;
    background-color: rgba(247, 240, 226, 0.18);
    transition-property: width, background-color;
    transition-duration: 0.12s;
}

.mission-health-segment--active {
    background-color: rgb(78, 214, 155);
}

.mission-health-segment--critical.mission-health-segment--active {
    background-color: rgb(255, 86, 91);
}

.mission-mayhem-card {
    width: 100%;
    min-height: 43px;
    margin-top: 18px;
    padding: 7px 0 0 0;
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 1px;
    border-bottom-width: 0;
    border-left-color: transparent;
    border-right-color: transparent;
    border-top-color: rgba(255, 255, 255, 0.09);
    border-bottom-color: transparent;
    transition-property: background-color;
    transition-duration: 0.16s;
}

.mission-mayhem-card--pulse {
    background-color: rgba(255, 255, 255, 0.04);
}

.mission-mayhem-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.mission-result-mayhem-label {
    color: rgba(255, 250, 238, 0.95);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1.15px;
}

.mission-mayhem-tier {
    color: var(--text);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1.05px;
}

.mission-mayhem-multiplier {
    color: var(--text);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0.45px;
}

.mission-mayhem-track {
    position: relative;
    height: 4px;
    margin-top: 6px;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.mission-mayhem-fill {
    position: relative;
    height: 4px;
    width: 0%;
    background-color: rgb(118, 129, 139);
    transition-property: background-color;
    transition-duration: 0.12s;
}

.mission-mayhem-fill-head {
    position: absolute;
    right: -3px;
    top: -2px;
    display: none;
    width: 8px;
    height: 8px;
    background-color: rgb(247, 240, 226);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    transform-origin: 50% 50%;
}

.mission-mayhem-card.mayhem-tier--rampage {
    background-color: transparent;
}

.mission-mayhem-card.mayhem-tier--carnage {
    background-color: transparent;
}

.mission-mayhem-card.mayhem-tier--slaughter {
    background-color: transparent;
}

.mission-mayhem-card.mayhem-tier--mayhem {
    background-color: transparent;
}

.mayhem-tier--rampage .mission-mayhem-tier,
.mayhem-tier--rampage .mission-mayhem-multiplier,
.mayhem-tier--rampage .mission-result-mayhem-value { color: rgb(255, 211, 92); }
.mayhem-tier--rampage .mission-mayhem-fill { background-color: rgb(255, 211, 92); }
.mayhem-tier--rampage .mission-mayhem-fill-head { background-color: rgb(255, 226, 126); }

.mayhem-tier--carnage .mission-mayhem-tier,
.mayhem-tier--carnage .mission-mayhem-multiplier,
.mayhem-tier--carnage .mission-result-mayhem-value { color: rgb(255, 151, 60); }
.mayhem-tier--carnage .mission-mayhem-fill { background-color: rgb(255, 151, 60); }
.mayhem-tier--carnage .mission-mayhem-fill-head { background-color: rgb(255, 188, 92); }

.mayhem-tier--slaughter .mission-mayhem-tier,
.mayhem-tier--slaughter .mission-mayhem-multiplier,
.mayhem-tier--slaughter .mission-result-mayhem-value { color: rgb(255, 80, 86); }
.mayhem-tier--slaughter .mission-mayhem-fill { background-color: rgb(255, 80, 86); }
.mayhem-tier--slaughter .mission-mayhem-fill-head { background-color: rgb(255, 132, 122); }

.mayhem-tier--mayhem .mission-mayhem-tier,
.mayhem-tier--mayhem .mission-mayhem-multiplier,
.mayhem-tier--mayhem .mission-result-mayhem-value { color: rgb(255, 107, 217); }
.mayhem-tier--mayhem .mission-mayhem-fill { background-color: rgb(255, 67, 197); }
.mayhem-tier--mayhem .mission-mayhem-fill-head { background-color: rgb(82, 219, 255); }

.mission-mayhem-announcement {
    position: absolute;
    left: 0;
    right: 0;
    top: 38%;
    display: none;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform-origin: 50% 50%;
}

.mission-mayhem-announcement-copy {
    min-width: 300px;
    align-items: center;
}

.mission-mayhem-announcement-label {
    color: var(--text);
    font-size: 42px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
}

.mission-mayhem-announcement-meta {
    margin-top: 1px;
    flex-direction: row;
    align-items: center;
}

.mission-mayhem-announcement-multiplier {
    margin: 0 11px;
    color: var(--text);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.mission-mayhem-announcement-rule {
    width: 38px;
    height: 2px;
    background-color: var(--text);
}

.mission-mayhem-streak-pack {
    width: 128px;
    height: 52px;
    justify-content: center;
}

.mission-mayhem-streak-pack--left {
    margin-right: 22px;
    align-items: flex-end;
}

.mission-mayhem-streak-pack--right {
    margin-left: 22px;
    align-items: flex-start;
}

.mission-mayhem-streak {
    height: 2px;
    margin: 3px 0;
    background-color: var(--text);
}

.mission-mayhem-streak--long {
    width: 124px;
}

.mission-mayhem-streak--medium {
    width: 82px;
    opacity: 0.72;
}

.mission-mayhem-streak--short {
    width: 46px;
    opacity: 0.42;
}

.mission-mayhem-announcement.mayhem-tier--rampage .mission-mayhem-announcement-label,
.mission-mayhem-announcement.mayhem-tier--rampage .mission-mayhem-announcement-multiplier { color: rgb(255, 211, 92); }
.mission-mayhem-announcement.mayhem-tier--rampage .mission-mayhem-announcement-rule,
.mission-mayhem-announcement.mayhem-tier--rampage .mission-mayhem-streak { background-color: rgb(255, 211, 92); }

.mission-mayhem-announcement.mayhem-tier--carnage .mission-mayhem-announcement-label,
.mission-mayhem-announcement.mayhem-tier--carnage .mission-mayhem-announcement-multiplier { color: rgb(255, 151, 60); }
.mission-mayhem-announcement.mayhem-tier--carnage .mission-mayhem-announcement-rule,
.mission-mayhem-announcement.mayhem-tier--carnage .mission-mayhem-streak { background-color: rgb(255, 151, 60); }

.mission-mayhem-announcement.mayhem-tier--slaughter .mission-mayhem-announcement-label,
.mission-mayhem-announcement.mayhem-tier--slaughter .mission-mayhem-announcement-multiplier { color: rgb(255, 80, 86); }
.mission-mayhem-announcement.mayhem-tier--slaughter .mission-mayhem-announcement-rule,
.mission-mayhem-announcement.mayhem-tier--slaughter .mission-mayhem-streak { background-color: rgb(255, 80, 86); }

.mission-mayhem-announcement.mayhem-tier--mayhem .mission-mayhem-announcement-label,
.mission-mayhem-announcement.mayhem-tier--mayhem .mission-mayhem-announcement-multiplier { color: rgb(255, 107, 217); }
.mission-mayhem-announcement.mayhem-tier--mayhem .mission-mayhem-announcement-rule,
.mission-mayhem-announcement.mayhem-tier--mayhem .mission-mayhem-streak { background-color: rgb(82, 219, 255); }

.mission-effect-feedback {
    display: none;
    min-width: 235px;
    margin-left: 6px;
    margin-bottom: 12px;
    flex-direction: row;
    align-items: center;
    transform-origin: 0% 50%;
}

.mission-effect-feedback-strike {
    width: 13px;
    height: 46px;
    margin-right: 10px;
    justify-content: center;
}

.mission-effect-feedback-strike-main {
    width: 4px;
    height: 34px;
    background-color: var(--accent);
}

.mission-effect-feedback-strike-tail {
    width: 9px;
    height: 3px;
    margin-top: 3px;
    background-color: var(--accent);
}

.mission-effect-feedback-copy {
    min-width: 0;
}

.mission-effect-feedback-title {
    color: var(--text);
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1.05px;
}

.mission-effect-feedback-detail {
    margin-top: 2px;
    color: rgb(255, 177, 77);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0.85px;
}

.mission-effect-feedback--impact .mission-effect-feedback-strike-main,
.mission-effect-feedback--impact .mission-effect-feedback-strike-tail {
    background-color: rgb(255, 151, 60);
}

.mission-effect-feedback--impact .mission-effect-feedback-detail {
    color: rgb(255, 177, 77);
}

.mission-effect-feedback--defense .mission-effect-feedback-strike-main,
.mission-effect-feedback--defense .mission-effect-feedback-strike-tail {
    background-color: rgb(82, 219, 255);
}

.mission-effect-feedback--defense .mission-effect-feedback-detail {
    color: rgb(82, 219, 255);
}

.mission-effect-feedback--repair .mission-effect-feedback-strike-main,
.mission-effect-feedback--repair .mission-effect-feedback-strike-tail {
    background-color: var(--positive);
}

.mission-effect-feedback--repair .mission-effect-feedback-detail {
    color: var(--positive);
}

.mission-result {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 32px;
    background-color: rgba(35, 32, 29, 0.82);
}

.mission-result-panel {
    position: relative;
    width: 1040px;
    max-width: 90%;
    padding: 34px 44px 32px 44px;
    align-items: stretch;
    background-color: rgba(58, 54, 49, 0.97);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(244, 234, 216, 0.22);
    border-bottom-color: rgba(244, 234, 216, 0.22);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}

.mission-result-header {
    align-items: flex-start;
}

.mission-result-eyebrow {
    color: rgba(255, 250, 238, 0.94);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1.6px;
}

.mission-result-status-line {
    height: 26px;
    margin-top: 15px;
    flex-direction: row;
    align-items: center;
}

.mission-result-status-mark {
    width: 28px;
    height: 3px;
    margin-right: 10px;
    background-color: var(--accent);
}

.mission-result-panel--success .mission-result-status-mark {
    background-color: var(--positive);
}

.mission-result-panel--failure .mission-result-status-mark {
    background-color: var(--negative);
}

.mission-result-status {
    padding: 0;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1.3px;
}

.mission-result-status--success {
    color: var(--positive);
    background-color: transparent;
}

.mission-result-status--failure {
    color: var(--negative);
    background-color: transparent;
}

.mission-result-title {
    margin-top: 4px;
    color: var(--text);
    font-size: 48px;
    -unity-font-style: bold;
    letter-spacing: 1.7px;
}

.mission-result-description {
    max-width: 760px;
    margin-top: 7px;
    color: rgba(255, 250, 238, 0.96);
    font-size: 18px;
    -unity-text-align: middle-left;
    white-space: normal;
}

.mission-result-rule {
    width: 100%;
    height: 1px;
    margin-top: 22px;
    background-color: rgba(244, 234, 216, 0.24);
}

.mission-result-rule--subtle {
    margin-top: 2px;
    background-color: rgba(244, 234, 216, 0.11);
}

.mission-result-metrics {
    width: 100%;
    height: 102px;
    flex-direction: row;
    align-items: center;
}

.mission-result-metric {
    flex-grow: 1;
    min-width: 110px;
    padding-left: 20px;
    padding-right: 20px;
    align-items: flex-start;
    background-color: transparent;
}

.mission-result-metric-divider {
    width: 1px;
    height: 48px;
    background-color: rgba(244, 234, 216, 0.16);
}

.mission-result-metric-label {
    color: rgba(255, 250, 238, 0.92);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.mission-result-metric-value {
    margin-top: 7px;
    color: var(--text);
    font-size: 32px;
    -unity-font-style: bold;
    letter-spacing: 0.4px;
}

.mission-result-lower {
    width: 100%;
    min-height: 138px;
    padding-top: 23px;
    flex-direction: row;
    align-items: stretch;
}

.mission-result-mayhem {
    width: 45%;
    padding-right: 26px;
    flex-direction: row;
    align-items: center;
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.mission-result-mayhem-block {
    flex-grow: 1;
    align-items: flex-start;
}

.mission-result-mayhem-value {
    margin-top: 8px;
    color: var(--text);
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
}

.mission-result-mayhem-divider {
    width: 1px;
    height: 50px;
    margin-left: 17px;
    margin-right: 17px;
    background-color: rgba(244, 234, 216, 0.15);
}

.mission-result-section-divider {
    width: 1px;
    margin-right: 30px;
    background-color: rgba(244, 234, 216, 0.18);
}

.mission-result-reward {
    flex-grow: 1;
    max-width: none;
    padding: 0;
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.mission-result-reward-row,
.mission-result-reward-balance {
    height: 25px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.mission-result-reward-label,
.mission-result-reward-total-label {
    color: rgba(255, 250, 238, 0.92);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
}

.mission-result-reward-value {
    color: var(--text);
    font-size: 18px;
    -unity-font-style: bold;
}

.mission-result-reward-total {
    height: 47px;
    margin-top: 6px;
    padding-top: 9px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.09);
}

.mission-result-reward-total-value {
    color: var(--accent);
    font-size: 29px;
    -unity-font-style: bold;
}

.mission-result-reward-balance {
    margin-top: 3px;
}

.mission-result-reward-balance-value {
    color: rgba(255, 250, 238, 0.96);
    font-size: 18px;
    -unity-font-style: bold;
}

.mission-result-button {
    width: 244px;
    height: 50px;
    margin-top: 25px;
    align-self: flex-end;
    color: rgb(255, 250, 238);
    background-color: var(--accent);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    -unity-font-style: bold;
    font-size: 15px;
    letter-spacing: 0.8px;
}

.mission-pause-button {
    position: absolute;
    right: 20px;
    top: 18px;
    width: 48px;
    height: 38px;
    display: none;
    color: rgb(220, 231, 239);
    background-color: rgba(8, 11, 14, 0.78);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.15);
    border-right-color: rgba(255, 255, 255, 0.15);
    border-top-color: rgba(103, 186, 255, 0.72);
    border-bottom-color: rgba(255, 255, 255, 0.15);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    font-size: 15px;
    -unity-font-style: bold;
}

.mission-pause-button:hover {
    color: rgb(8, 13, 18);
    background-color: var(--accent);
}

.mission-intro,
.mission-pause,
.settings-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
}

.mission-intro {
    pointer-events: none;
    background-color: rgba(26, 24, 21, 0.34);
}

.mission-intro-stage {
    width: 620px;
    max-width: 88%;
    align-items: center;
}

.mission-intro-title-lockup {
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.mission-intro-title-rule {
    width: 78px;
    height: 2px;
    margin-right: 20px;
    background-color: var(--accent);
}

.mission-intro-title-rule--right {
    margin-left: 20px;
    margin-right: 0;
}

.mission-intro-label {
    color: rgba(247, 240, 226, 0.72);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
}

.mission-intro-vehicle {
    color: var(--text);
    font-size: 42px;
    -unity-font-style: bold;
    letter-spacing: 2.2px;
    -unity-text-align: middle-center;
}

.settings-rule {
    height: 1px;
    margin-top: 13px;
    margin-bottom: 14px;
    background-color: rgba(255, 255, 255, 0.10);
}

.mission-intro-objectives {
    width: 330px;
    margin-top: 18px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.mission-intro-objective {
    flex-grow: 1;
    align-items: center;
}

.mission-intro-value {
    margin-top: 3px;
    color: var(--text);
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 0.9px;
}

.mission-intro-divider {
    width: 1px;
    height: 44px;
    margin-left: 24px;
    margin-right: 24px;
    background-color: rgba(247, 240, 226, 0.24);
}

.mission-intro-countdown-row {
    width: 420px;
    margin-top: 24px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.mission-intro-countdown-rule {
    flex-grow: 1;
    height: 1px;
    margin-right: 15px;
    background-color: rgba(255, 95, 37, 0.55);
}

.mission-intro-countdown-rule--right {
    margin-left: 15px;
    margin-right: 0;
}

.mission-intro-countdown-shell {
    position: relative;
    width: 118px;
    height: 118px;
    align-items: center;
    justify-content: center;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
    border-top-left-radius: 59px;
    border-top-right-radius: 59px;
    border-bottom-left-radius: 59px;
    border-bottom-right-radius: 59px;
    background-color: rgba(43, 40, 36, 0.66);
    transform-origin: 50% 50%;
}

.mission-intro-countdown-ring {
    position: absolute;
    left: 7px;
    right: 7px;
    top: 7px;
    bottom: 7px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(247, 240, 226, 0.28);
    border-right-color: rgba(247, 240, 226, 0.28);
    border-top-color: rgba(247, 240, 226, 0.28);
    border-bottom-color: rgba(247, 240, 226, 0.28);
    border-top-left-radius: 52px;
    border-top-right-radius: 52px;
    border-bottom-left-radius: 52px;
    border-bottom-right-radius: 52px;
}

.mission-intro-countdown {
    color: var(--accent);
    font-size: 62px;
    -unity-font-style: bold;
    letter-spacing: -1px;
    -unity-text-align: middle-center;
}

.mission-intro-countdown-shell--launch {
    width: 180px;
    height: 68px;
    border-top-left-radius: 34px;
    border-top-right-radius: 34px;
    border-bottom-left-radius: 34px;
    border-bottom-right-radius: 34px;
}

.mission-intro-countdown-shell--launch .mission-intro-countdown-ring {
    border-top-left-radius: 27px;
    border-top-right-radius: 27px;
    border-bottom-left-radius: 27px;
    border-bottom-right-radius: 27px;
}

.mission-intro-countdown-shell--launch .mission-intro-countdown {
    font-size: 23px;
    letter-spacing: 1.8px;
}

.mission-pause,
.settings-overlay {
    background-color: rgba(3, 6, 9, 0.78);
}

.mission-pause-panel,
.settings-panel {
    width: 430px;
    max-width: 88%;
    padding: 25px 27px 27px 27px;
    background-color: rgba(13, 17, 22, 0.985);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 3px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.13);
    border-right-color: rgba(255, 255, 255, 0.13);
    border-top-color: var(--accent);
    border-bottom-color: rgba(255, 255, 255, 0.13);
    border-top-left-radius: 13px;
    border-top-right-radius: 13px;
    border-bottom-left-radius: 13px;
    border-bottom-right-radius: 13px;
}

.mission-pause-eyebrow,
.settings-eyebrow {
    color: var(--accent);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1.35px;
}

.mission-pause-title,
.settings-title {
    margin-top: 8px;
    color: var(--text);
    font-size: 27px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
}

.mission-pause-summary {
    height: 70px;
    margin-top: 19px;
    margin-bottom: 18px;
    padding: 10px 12px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.035);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.mission-pause-metric {
    flex-grow: 1;
    align-items: center;
}

.mission-pause-metric-label {
    color: var(--text-dim);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 0.9px;
}

.mission-pause-metric-value {
    margin-top: 4px;
    color: var(--text);
    font-size: 16px;
    -unity-font-style: bold;
}

.mission-pause-divider {
    width: 1px;
    height: 32px;
    background-color: rgba(255, 255, 255, 0.11);
}

.pause-primary-button,
.pause-secondary-button,
.pause-settings-button,
.settings-action-button,
.settings-close-button {
    height: 41px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.75px;
}

.pause-primary-button {
    color: rgb(7, 12, 16);
    background-color: var(--accent);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.mission-pause-actions {
    margin-top: 8px;
    flex-direction: row;
}

.pause-secondary-button {
    flex-grow: 1;
    color: var(--text-soft);
    background-color: rgba(255, 255, 255, 0.045);
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
}

.pause-restart-button {
    margin-right: 6px;
}

.pause-secondary-button--danger:hover {
    color: var(--negative);
    border-left-color: rgba(255, 102, 111, 0.55);
    border-right-color: rgba(255, 102, 111, 0.55);
    border-top-color: rgba(255, 102, 111, 0.55);
    border-bottom-color: rgba(255, 102, 111, 0.55);
}

.pause-settings-button,
.settings-close-button {
    margin-top: 8px;
    color: var(--text-soft);
    background-color: transparent;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
}

.mission-pause-hint {
    margin-top: 14px;
    color: var(--text-dim);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 1.05px;
    -unity-text-align: middle-center;
}

.settings-overlay {
    background-color: rgba(3, 6, 9, 0.88);
}

.settings-volume-header,
.settings-screen-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.settings-label {
    color: var(--text-soft);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.9px;
}

.settings-value {
    color: var(--accent);
    font-size: 12px;
    -unity-font-style: bold;
}

.settings-slider {
    height: 28px;
    margin-top: 7px;
    margin-bottom: 19px;
}

.settings-slider .unity-base-slider__tracker {
    height: 5px;
    background-color: rgba(255, 255, 255, 0.10);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.settings-slider .unity-base-slider__dragger {
    width: 15px;
    height: 15px;
    background-color: var(--accent);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.settings-screen-row {
    min-height: 58px;
    padding-top: 11px;
    padding-bottom: 11px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.settings-description {
    margin-top: 4px;
    color: var(--text-dim);
    font-size: 9px;
}

.settings-feedback {
    min-height: 18px;
    -unity-text-align: middle-center;
}

.settings-action-button {
    width: 132px;
    color: var(--text);
    background-color: rgba(103, 186, 255, 0.12);
    border-left-color: rgba(103, 186, 255, 0.42);
    border-right-color: rgba(103, 186, 255, 0.42);
    border-top-color: rgba(103, 186, 255, 0.42);
    border-bottom-color: rgba(103, 186, 255, 0.42);
}

.settings-row-copy {
    flex-grow: 1;
    flex-shrink: 1;
}

.settings-commerce-actions {
    flex-direction: row;
    align-items: center;
}

.settings-action-button--compact {
    width: 92px;
    margin-left: 6px;
}

/* Mockup B: warm concrete stage, restrained charcoal holders, orange actions. */
:root {
    --garage-bg: rgba(52, 48, 43, 0.98);
    --panel-bg: rgba(70, 66, 60, 0.94);
    --panel-soft: rgba(87, 82, 74, 0.92);
    --panel-hover: rgba(103, 96, 86, 0.96);
    --border: rgba(244, 234, 216, 0.16);
    --border-strong: rgba(244, 234, 216, 0.28);
    --text: rgb(247, 240, 226);
    --text-soft: rgb(211, 202, 186);
    --text-dim: rgb(166, 158, 145);
    --accent: rgb(241, 91, 43);
    --accent-soft: rgba(241, 91, 43, 0.16);
    --positive: rgb(87, 207, 145);
    --negative: rgb(255, 105, 99);
}

.garage-root {
    --garage-bg: rgba(52, 48, 43, 0.98);
    --panel-bg: rgba(70, 66, 60, 0.94);
    --panel-soft: rgba(87, 82, 74, 0.92);
    --panel-hover: rgba(103, 96, 86, 0.96);
    --border: rgba(244, 234, 216, 0.16);
    --border-strong: rgba(244, 234, 216, 0.28);
    --text: rgb(247, 240, 226);
    --text-soft: rgb(211, 202, 186);
    --text-dim: rgb(166, 158, 145);
    --accent: rgb(241, 91, 43);
    --accent-soft: rgba(241, 91, 43, 0.16);
    --positive: rgb(87, 207, 145);
    --negative: rgb(255, 105, 99);
}

.garage-root .topbar,
.garage-root .footerbar {
    background-color: rgba(52, 48, 43, 0.98);
    border-color: rgba(244, 234, 216, 0.13);
}

.garage-root .brand-title,
.garage-root .balance-value,
.garage-root .top-tab--selected {
    color: var(--text);
}

.garage-root .top-tab,
.garage-root .top-tab:hover,
.garage-root .top-tab:active,
.garage-root .top-tab--selected {
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.garage-root .top-tab {
    color: rgba(211, 202, 186, 0.68);
}

.garage-root .top-tab:hover {
    color: var(--text-soft);
}

.garage-root .top-tab--selected {
    color: var(--text);
    -unity-font-style: bold;
}

.garage-root .topbar-settings-button {
    color: var(--text-soft);
}

.garage-root .topbar-settings-button:hover {
    color: var(--text);
    background-color: rgba(244, 234, 216, 0.09);
}

.garage-root .content-row {
    background-color: rgba(60, 56, 51, 0.05);
}

.garage-root .stage-context {
    color: rgba(247, 240, 226, 0.72);
}

.garage-root .drag-hint,
.garage-root .showroom-caption {
    color: var(--text);
    background-color: rgba(72, 68, 62, 0.88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(244, 234, 216, 0.20);
    border-right-color: rgba(244, 234, 216, 0.20);
    border-top-color: rgba(244, 234, 216, 0.20);
    border-bottom-color: rgba(244, 234, 216, 0.20);
}

.garage-root .drag-copy,
.garage-root .showroom-caption-meta {
    color: var(--text-soft);
}

.garage-root .drag-hint {
    right: 22px;
    top: 20px;
    min-width: 250px;
    height: 50px;
    padding: 0 18px;
    justify-content: center;
    background-color: rgba(109, 102, 94, 0.92);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.garage-root .drag-icon {
    margin-right: 10px;
    color: var(--accent);
    font-size: 17px;
}

.garage-root .drag-copy {
    color: var(--text);
    font-size: 11px;
    letter-spacing: 0.75px;
}

.garage-root .showroom-caption-meta {
    border-left-color: rgba(244, 234, 216, 0.20);
}

.garage-root .showroom-arrow {
    color: rgb(41, 38, 34);
    top: 46%;
    width: 64px;
    height: 64px;
    background-color: rgba(239, 231, 214, 0.96);
    border-left-color: rgba(45, 42, 38, 0.30);
    border-right-color: rgba(45, 42, 38, 0.30);
    border-top-color: rgba(45, 42, 38, 0.30);
    border-bottom-color: rgba(45, 42, 38, 0.30);
    border-top-left-radius: 32px;
    border-top-right-radius: 32px;
    border-bottom-left-radius: 32px;
    border-bottom-right-radius: 32px;
    font-size: 40px;
}

.garage-root .showroom-arrow--left {
    left: 27%;
}

.garage-root .showroom-arrow--right {
    right: 22%;
}

.garage-root .showroom-arrow:hover {
    color: rgb(255, 250, 238);
    background-color: var(--accent);
    border-left-color: rgba(255, 250, 238, 0.58);
    border-right-color: rgba(255, 250, 238, 0.58);
    border-top-color: rgba(255, 250, 238, 0.58);
    border-bottom-color: rgba(255, 250, 238, 0.58);
}

/* Stats float directly on the stage; the slider remains a passive readout. */
.garage-root .stats-panel {
    left: 54px;
    width: 344px;
    padding: 0;
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.garage-root .stat-card {
    height: 62px;
    min-width: 0;
    margin-right: 0;
    margin-bottom: 2px;
    padding: 0;
    background-color: transparent;
    border-bottom-width: 0;
}

.garage-root .stat-header,
.garage-root .stat-value-row {
    height: 37px;
}

.garage-root .stat-name {
    width: 124px;
    color: var(--text);
    font-size: 13px;
    letter-spacing: 0.65px;
}

.garage-root .stat-value {
    color: var(--text);
    font-size: 16px;
}

.garage-root .stat-delta {
    min-width: 68px;
    font-size: 11px;
}

.garage-root .stat-track {
    height: 6px;
    margin-top: 0;
    margin-bottom: 11px;
    background-color: rgba(244, 234, 216, 0.19);
}

.garage-root .stat-current-fill,
.garage-root .stat-preview-fill {
    background-color: rgba(247, 240, 226, 0.82);
}

.garage-root .stat-preview-fill--positive {
    background-color: var(--positive);
}

.garage-root .stat-preview-fill--negative {
    background-color: var(--negative);
}

/* Gallery identity is typography, not another card. */
.garage-screen--gallery .context-drawer {
    bottom: 24px;
    width: 680px;
    min-width: 600px;
    max-width: 760px;
    min-height: 106px;
    max-height: 118px;
    padding: 0;
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.garage-screen--gallery .detail-block {
    justify-content: center;
}

.garage-screen--gallery .detail-copy {
    flex-grow: 1;
    align-items: center;
    padding-right: 32px;
}

.garage-screen--gallery .detail-title {
    color: var(--text);
    font-size: 38px;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
}

.garage-screen--gallery .detail-description {
    min-height: 24px;
    max-height: 26px;
    margin-top: 7px;
    color: var(--text-soft);
    font-size: 13px;
    letter-spacing: 1.8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.garage-screen--gallery .detail-action-block {
    width: 190px;
    min-height: 58px;
    padding-left: 30px;
    justify-content: center;
    border-left-width: 1px;
    border-left-color: rgba(244, 234, 216, 0.35);
}

.garage-screen--gallery .primary-action:disabled {
    color: var(--text-soft);
    background-color: transparent;
    opacity: 1;
}

.garage-screen--gallery .context-hint {
    display: none;
}

/* Parts keeps one quiet action surface because price and ownership must read clearly. */
.garage-screen--parts .context-drawer {
    background-color: rgba(55, 52, 48, 0.91);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(244, 234, 216, 0.18);
    border-right-color: rgba(244, 234, 216, 0.18);
    border-top-color: rgba(244, 234, 216, 0.18);
    border-bottom-color: rgba(244, 234, 216, 0.18);
}

.garage-screen--parts .detail-title,
.garage-screen--parts .detail-description {
    color: var(--text);
}

.garage-screen--parts .detail-description,
.garage-screen--parts .context-hint {
    color: var(--text-soft);
}

.garage-screen--parts .detail-action-block {
    border-left-color: rgba(244, 234, 216, 0.18);
}

.garage-root .filter-chip {
    color: var(--text-soft);
    background-color: rgba(58, 55, 50, 0.86);
    border-left-color: rgba(244, 234, 216, 0.26);
    border-right-color: rgba(244, 234, 216, 0.26);
    border-top-color: rgba(244, 234, 216, 0.26);
    border-bottom-color: rgba(244, 234, 216, 0.26);
}

.garage-root .filter-chip:hover {
    color: var(--text);
    background-color: rgba(82, 77, 69, 0.94);
}

.garage-root .filter-chip--selected,
.garage-root .filter-chip--selected:hover {
    color: var(--text);
    background-color: rgba(58, 55, 50, 0.94);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.garage-root .primary-action,
.garage-root .mission-button {
    color: rgb(255, 250, 238);
    background-color: var(--accent);
}

.garage-root .primary-action:hover,
.garage-root .mission-button:hover {
    background-color: rgb(255, 112, 54);
}

.garage-root .primary-action:disabled,
.garage-root .mission-button:disabled {
    color: rgba(247, 240, 226, 0.48);
    background-color: rgba(108, 102, 93, 0.68);
}

/* The mission HUD adopts the same warm holders without changing its geometry. */
.mission-top-row,
.mission-pause-button {
    color: var(--text);
    background-color: rgba(52, 48, 43, 0.90);
    border-left-color: rgba(244, 234, 216, 0.18);
    border-right-color: rgba(244, 234, 216, 0.18);
    border-top-color: rgba(244, 234, 216, 0.18);
    border-bottom-color: rgba(244, 234, 216, 0.18);
}

.mission-strip-divider,
.mission-run-status,
.mission-mayhem-card,
.mission-result-mayhem-divider,
.mission-pause-divider {
    border-color: rgba(244, 234, 216, 0.16);
}

.mission-strip-divider,
.mission-result-mayhem-divider,
.mission-pause-divider {
    background-color: rgba(244, 234, 216, 0.16);
}

.mission-kicker,
.mission-speed-unit {
    color: rgba(247, 240, 226, 0.82);
}

.mission-result-eyebrow,
.mission-result-metric-label,
.mission-result-mayhem-label,
.mission-result-reward-label,
.mission-result-reward-total-label {
    color: rgba(255, 250, 238, 0.95);
}

.mission-intro-label,
.mission-pause-metric-label,
.mission-pause-hint,
.settings-label,
.settings-description {
    color: var(--text-dim);
}

.mission-primary-value,
.mission-timer,
.mission-current-speed,
.mission-vehicle-name,
.mission-health-value,
.mission-result-title,
.mission-result-metric-value,
.mission-result-mayhem-value,
.mission-intro-vehicle,
.mission-intro-value,
.mission-pause-title,
.mission-pause-metric-value,
.settings-title,
.settings-action-button {
    color: var(--text);
}

.mission-speedometer {
    background-color: rgba(61, 57, 52, 0.88);
    border-left-color: rgba(244, 234, 216, 0.22);
    border-right-color: rgba(244, 234, 216, 0.22);
    border-top-color: rgba(244, 234, 216, 0.22);
    border-bottom-color: rgba(244, 234, 216, 0.22);
}

.mission-speed-tick-mark {
    background-color: rgba(244, 234, 216, 0.44);
}

.mission-speed-needle-bar {
    background-color: var(--accent);
}

.mission-health-tag {
    color: var(--accent);
}

.mission-speed-hub {
    background-color: var(--text);
}

.mission-run-status {
    border-left-color: rgba(244, 234, 216, 0.22);
}

.mission-mayhem-card {
    border-top-color: rgba(244, 234, 216, 0.13);
}

.mission-mayhem-track,
.settings-slider .unity-base-slider__tracker {
    background-color: rgba(244, 234, 216, 0.13);
}

.mission-health-segment {
    background-color: rgba(247, 240, 226, 0.18);
}

.mission-health-segments .mission-health-segment--active {
    background-color: var(--positive);
}

.mission-health-segments .mission-health-segment--critical.mission-health-segment--active {
    background-color: var(--negative);
}

.mission-result,
.mission-pause,
.settings-overlay {
    background-color: rgba(35, 32, 29, 0.78);
}

.mission-intro {
    background-color: rgba(43, 40, 36, 0.34);
}

.mission-result-panel,
.mission-pause-panel,
.settings-panel {
    background-color: rgba(58, 54, 49, 0.97);
    border-left-color: rgba(244, 234, 216, 0.20);
    border-right-color: rgba(244, 234, 216, 0.20);
    border-bottom-color: rgba(244, 234, 216, 0.20);
}

.mission-result-panel--success {
    border-top-color: rgba(244, 234, 216, 0.22);
}

.mission-result-panel--failure {
    border-top-color: rgba(244, 234, 216, 0.22);
}

.mission-pause-summary,
.pause-secondary-button,
.settings-action-button {
    background-color: rgba(244, 234, 216, 0.07);
    border-color: rgba(244, 234, 216, 0.16);
}

.mission-result-reward {
    background-color: transparent;
    border-left-color: transparent;
    border-right-color: transparent;
    border-top-color: transparent;
    border-bottom-color: transparent;
}

.pause-secondary-button,
.pause-settings-button,
.settings-close-button {
    color: var(--text-soft);
}

.mission-result-description {
    color: rgba(255, 250, 238, 0.96);
}

.mission-result-button,
.pause-primary-button,
.settings-slider .unity-base-slider__dragger {
    color: rgb(255, 250, 238);
    background-color: var(--accent);
    border-color: var(--accent);
}

.mission-pause-button:hover {
    color: rgb(255, 250, 238);
    background-color: var(--accent);
}

/* CrazyGames rewarded surfaces use the existing garage language. */
.garage-root .topbar-actions {
    min-width: 360px;
}

.salvage-drop-button {
    height: 38px;
    margin-right: 18px;
    padding-left: 18px;
    padding-right: 18px;
    color: rgb(255, 250, 238);
    background-color: rgba(244, 234, 216, 0.08);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(241, 88, 36, 0.72);
    border-right-color: rgba(241, 88, 36, 0.72);
    border-top-color: rgba(241, 88, 36, 0.72);
    border-bottom-color: rgba(241, 88, 36, 0.72);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
}

.salvage-drop-button:hover {
    background-color: rgba(241, 88, 36, 0.18);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.garage-ad-free-button {
    height: 36px;
    min-width: 142px;
    max-width: 176px;
    margin-right: 16px;
    padding-left: 12px;
    padding-right: 12px;
    color: rgb(255, 250, 238);
    background-color: rgba(241, 88, 36, 0.16);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(241, 88, 36, 0.78);
    border-right-color: rgba(241, 88, 36, 0.78);
    border-top-color: rgba(241, 88, 36, 0.78);
    border-bottom-color: rgba(241, 88, 36, 0.78);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.45px;
}

.garage-ad-free-button:hover {
    background-color: rgba(241, 88, 36, 0.28);
}

.garage-ad-free-button:disabled {
    opacity: 0.72;
}

.mission-result-rewarded-bonus {
    color: var(--positive);
}

.mission-result-rewarded-status {
    min-height: 22px;
    margin-top: 15px;
    color: rgba(255, 250, 238, 0.92);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0.7px;
    -unity-text-align: middle-center;
}

.mission-result-rewarded-status--success {
    color: var(--positive);
}

.mission-result-actions {
    width: 100%;
    margin-top: 23px;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.mission-result-actions .mission-result-button {
    width: 244px;
    margin-top: 0;
    align-self: auto;
}

.mission-result-rewarded-button {
    margin-left: 12px;
    color: rgb(255, 250, 238);
    background-color: rgba(244, 234, 216, 0.08);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.mission-result-rewarded-button:hover {
    background-color: rgba(241, 88, 36, 0.18);
}

.mission-result-rewarded-button:disabled {
    opacity: 0.72;
}

/* iOS-only sizing. The class is added by IosSafeAreaController, so WebGL keeps
   its existing desktop layout. */
.platform-ios .topbar {
    height: 88px;
}

.platform-ios .brand-title {
    font-size: 22px;
}

.platform-ios .balance-value {
    font-size: 21px;
}

.platform-ios .top-tab {
    min-height: 52px;
    padding-left: 22px;
    padding-right: 22px;
    font-size: 16px;
}

.platform-ios .topbar-settings-button {
    width: 52px;
    height: 52px;
    margin-right: 14px;
    font-size: 16px;
}

.platform-ios .showroom-arrow {
    width: 76px;
    height: 76px;
    border-top-left-radius: 38px;
    border-top-right-radius: 38px;
    border-bottom-left-radius: 38px;
    border-bottom-right-radius: 38px;
}

.platform-ios .filter-chip {
    min-height: 50px;
    padding-left: 18px;
    padding-right: 18px;
    font-size: 14px;
}

.platform-ios .primary-action,
.platform-ios .mission-button,
.platform-ios .mission-result-button,
.platform-ios .mission-result-rewarded-button,
.platform-ios .pause-primary-button,
.platform-ios .pause-secondary-button,
.platform-ios .pause-settings-button,
.platform-ios .settings-action-button,
.platform-ios .settings-close-button {
    min-height: 58px;
    font-size: 16px;
}

.platform-ios .mission-pause-button {
    width: 64px;
    height: 56px;
    font-size: 20px;
}

.platform-ios .mission-kicker,
.platform-ios .mission-health-tag,
.platform-ios .mission-speed-unit {
    font-size: 14px;
}

.platform-ios .mission-primary-value {
    font-size: 26px;
}

.platform-ios .mission-timer {
    font-size: 28px;
}

.platform-ios .settings-slider {
    min-height: 52px;
}

/* App Store settings content can exceed a landscape phone's height. */
.settings-panel {
    height: 88%;
    max-height: 88%;
}

.settings-scroll {
    flex-grow: 1;
    min-height: 0;
    margin-top: 10px;
    margin-bottom: 4px;
}

.settings-action-button--danger {
    color: rgb(255, 184, 178);
    background-color: rgba(190, 46, 54, 0.16);
    border-left-color: rgba(255, 102, 111, 0.55);
    border-right-color: rgba(255, 102, 111, 0.55);
    border-top-color: rgba(255, 102, 111, 0.55);
    border-bottom-color: rgba(255, 102, 111, 0.55);
}

.settings-action-button--danger:hover {
    color: rgb(255, 238, 236);
    background-color: rgba(190, 46, 54, 0.30);
}

.account-delete-overlay {
    background-color: rgba(3, 6, 9, 0.94);
}

.account-delete-panel {
    height: auto;
    max-height: 88%;
}

.account-delete-eyebrow {
    color: rgb(255, 126, 118);
}

.account-delete-description {
    margin-top: 18px;
    margin-bottom: 20px;
    color: var(--text-soft);
    font-size: 11px;
    white-space: normal;
}

.account-delete-actions {
    flex-direction: row;
    align-items: center;
}

.account-delete-cancel-button,
.account-delete-confirm-button {
    flex-grow: 1;
}

.account-delete-cancel-button {
    margin-right: 8px;
}

.account-delete-confirm-button {
    width: 190px;
}

.service-notification-overlay {
    background-color: rgba(3, 6, 9, 0.96);
}

.service-notification-panel {
    height: auto;
    max-height: 88%;
}

.service-notification-scroll {
    max-height: 240px;
    margin-top: 8px;
    margin-bottom: 8px;
}

/* iOS landscape compact layout.
   Keep this block last: the garage stylesheet contains several desktop design
   layers, while iPhone landscape has very little vertical UI space. */
.platform-ios .garage-root .topbar {
    height: 48px;
    padding-left: 14px;
    padding-right: 14px;
}

.platform-ios .garage-root .brand-row {
    flex-shrink: 0;
}

.platform-ios .garage-root .brand-mark {
    margin-right: 7px;
    font-size: 10px;
}

.platform-ios .garage-root .brand-title {
    font-size: 14px;
    letter-spacing: 0.8px;
}

.platform-ios .garage-root .tabbar {
    height: 48px;
    min-width: 200px;
    padding-left: 6px;
    padding-right: 6px;
}

.platform-ios .garage-root .top-tab {
    height: 40px;
    min-height: 40px;
    margin-left: 4px;
    margin-right: 4px;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 11px;
}

.platform-ios .garage-root .topbar-actions {
    width: auto;
    min-width: 272px;
    flex-shrink: 0;
}

.platform-ios .garage-root .garage-ad-free-button {
    width: 128px;
    min-width: 128px;
    max-width: 128px;
    height: 32px;
    margin-right: 10px;
    padding-left: 6px;
    padding-right: 6px;
    font-size: 8px;
    letter-spacing: 0.25px;
}

.platform-ios .garage-root .balance-value {
    font-size: 15px;
}

.platform-ios .garage-root .topbar-settings-button {
    width: 40px;
    height: 40px;
    margin-left: 8px;
    margin-right: 0;
    font-size: 15px;
}

.platform-ios .garage-root .footerbar {
    height: 52px;
}

.platform-ios .garage-root .mission-button {
    top: 6px;
    width: 230px;
    min-width: 230px;
    height: 40px;
    min-height: 40px;
    font-size: 12px;
}

.platform-ios .garage-root .drag-hint {
    right: 12px;
    top: 8px;
    min-width: 176px;
    height: 30px;
    padding-left: 9px;
    padding-right: 9px;
}

.platform-ios .garage-root .drag-copy {
    font-size: 8px;
}

.platform-ios .garage-root .showroom-caption {
    top: 8px;
    min-width: 182px;
    height: 30px;
    padding-left: 10px;
    padding-right: 10px;
}

.platform-ios .garage-root .showroom-caption-title {
    font-size: 9px;
}

.platform-ios .garage-root .showroom-caption-meta {
    margin-left: 9px;
    padding-left: 9px;
    font-size: 8px;
}

.platform-ios .garage-root .showroom-arrow {
    width: 44px;
    height: 44px;
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
    font-size: 27px;
}

.platform-ios .garage-root .showroom-arrow--left {
    left: 29%;
}

.platform-ios .garage-root .showroom-arrow--right {
    right: 27%;
}

.platform-ios .garage-root .showroom-arrow:hover {
    color: rgb(41, 38, 34);
    background-color: rgba(239, 231, 214, 0.96);
    border-left-color: rgba(45, 42, 38, 0.30);
    border-right-color: rgba(45, 42, 38, 0.30);
    border-top-color: rgba(45, 42, 38, 0.30);
    border-bottom-color: rgba(45, 42, 38, 0.30);
}

.platform-ios .garage-root .stats-panel {
    left: 14px;
    width: 200px;
    min-height: 0;
    max-height: none;
}

.platform-ios .garage-root .stat-card {
    height: 34px;
    margin-bottom: 1px;
}

.platform-ios .garage-root .stat-header,
.platform-ios .garage-root .stat-value-row {
    height: 20px;
}

.platform-ios .garage-root .stat-name {
    width: 77px;
    font-size: 8px;
}

.platform-ios .garage-root .stat-value {
    font-size: 10px;
}

.platform-ios .garage-root .stat-delta {
    min-width: 44px;
    margin-left: 4px;
    font-size: 8px;
}

.platform-ios .garage-root .stat-track {
    height: 3px;
    margin-bottom: 5px;
}

.platform-ios .garage-root.garage-screen--gallery .context-drawer,
.platform-ios .garage-root.garage-screen--parts .context-drawer {
    left: auto;
    right: 10px;
    bottom: 10px;
    width: 250px;
    min-width: 0;
    max-width: 250px;
    min-height: 68px;
    max-height: 76px;
    padding: 8px 9px;
    translate: 0 0;
    background-color: rgba(58, 54, 49, 0.94);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(244, 234, 216, 0.18);
    border-right-color: rgba(244, 234, 216, 0.18);
    border-top-color: rgba(244, 234, 216, 0.18);
    border-bottom-color: rgba(244, 234, 216, 0.18);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.platform-ios .garage-root.garage-screen--gallery .detail-copy,
.platform-ios .garage-root.garage-screen--parts .detail-copy {
    align-items: flex-start;
    padding-right: 8px;
}

.platform-ios .garage-root.garage-screen--gallery .detail-title,
.platform-ios .garage-root.garage-screen--parts .detail-title {
    font-size: 16px;
    letter-spacing: 0.8px;
    -unity-text-align: middle-left;
}

.platform-ios .garage-root.garage-screen--gallery .detail-description,
.platform-ios .garage-root.garage-screen--parts .detail-description {
    min-height: 14px;
    max-height: 16px;
    margin-top: 2px;
    font-size: 8px;
    letter-spacing: 0.5px;
    -unity-text-align: middle-left;
}

.platform-ios .garage-root.garage-screen--gallery .detail-action-block,
.platform-ios .garage-root.garage-screen--parts .detail-action-block {
    width: 104px;
    min-height: 44px;
    padding-left: 6px;
}

.platform-ios .garage-root.garage-screen--gallery .primary-action,
.platform-ios .garage-root.garage-screen--parts .primary-action {
    height: 44px;
    min-height: 44px;
    padding-left: 4px;
    padding-right: 4px;
    font-size: 8px;
    letter-spacing: 0.2px;
}

/* Parts needs more copy space than the vehicle gallery because attachment
   names and purchase states can both be long on a landscape phone. */
.platform-ios .garage-root.garage-screen--parts .context-drawer {
    width: 300px;
    max-width: 300px;
    min-height: 92px;
    max-height: 96px;
}

.platform-ios .garage-root.garage-screen--parts .detail-copy {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: center;
    overflow: hidden;
}

.platform-ios .garage-root.garage-screen--parts .detail-title {
    max-height: 31px;
    font-size: 11px;
    letter-spacing: 0.35px;
    white-space: normal;
    overflow: hidden;
}

.platform-ios .garage-root.garage-screen--parts .detail-description {
    display: none;
}

.platform-ios .garage-root.garage-screen--parts .context-hint {
    max-height: 12px;
    margin-top: 3px;
    font-size: 7px;
    letter-spacing: 0.35px;
    white-space: normal;
    overflow: hidden;
}

.platform-ios .garage-root.garage-screen--parts .detail-action-block {
    justify-content: center;
}

.platform-ios .garage-root.garage-screen--parts .primary-action {
    height: 42px;
    min-height: 42px;
}

.platform-ios .garage-root.garage-screen--parts .stats-panel {
    width: 220px;
}

.platform-ios .garage-root.garage-screen--parts .stat-name {
    width: 82px;
    margin-right: 4px;
    font-size: 7px;
}

.platform-ios .garage-root.garage-screen--parts .stat-value {
    font-size: 9px;
    white-space: nowrap;
}

.platform-ios .garage-root.garage-screen--parts .stat-delta {
    min-width: 36px;
    margin-left: 2px;
    font-size: 7px;
    white-space: nowrap;
}

.platform-ios .garage-root .filter-chip {
    height: 34px;
    min-height: 34px;
    padding-left: 10px;
    padding-right: 10px;
    font-size: 11px;
}

.platform-ios .mission-result {
    padding: 14px;
}

.platform-ios .mission-result-panel {
    width: 860px;
    max-width: 96%;
    max-height: 94%;
    padding: 14px 20px 16px 20px;
}

.platform-ios .mission-result-eyebrow {
    font-size: 10px;
}

.platform-ios .mission-result-status-line {
    display: none;
}

.platform-ios .mission-result-title {
    margin-top: 3px;
    font-size: 28px;
}

.platform-ios .mission-result-description {
    display: none;
}

.platform-ios .mission-result-rule {
    margin-top: 8px;
}

.platform-ios .mission-result-rule--subtle {
    margin-top: 1px;
}

.platform-ios .mission-result-metrics {
    height: 58px;
}

.platform-ios .mission-result-metric {
    min-width: 80px;
    padding-left: 12px;
    padding-right: 12px;
}

.platform-ios .mission-result-metric-label,
.platform-ios .mission-result-mayhem-label,
.platform-ios .mission-result-reward-label,
.platform-ios .mission-result-reward-total-label {
    font-size: 10px;
}

.platform-ios .mission-result-metric-value {
    margin-top: 3px;
    font-size: 20px;
}

.platform-ios .mission-result-lower {
    min-height: 106px;
    padding-top: 9px;
}

.platform-ios .mission-result-mayhem {
    padding-right: 16px;
}

.platform-ios .mission-result-mayhem-value {
    margin-top: 4px;
    font-size: 17px;
}

.platform-ios .mission-result-section-divider {
    margin-right: 18px;
}

.platform-ios .mission-result-reward-row,
.platform-ios .mission-result-reward-balance {
    height: 18px;
}

.platform-ios .mission-result-reward-value,
.platform-ios .mission-result-reward-balance-value {
    font-size: 13px;
}

.platform-ios .mission-result-reward-total {
    height: 30px;
    margin-top: 3px;
    padding-top: 4px;
}

.platform-ios .mission-result-reward-total-value {
    font-size: 19px;
}

.platform-ios .mission-result-rewarded-status {
    min-height: 16px;
    margin-top: 4px;
    font-size: 10px;
}

.platform-ios .mission-result-actions {
    margin-top: 7px;
}

.platform-ios .mission-result-actions .mission-result-button {
    width: 210px;
    height: 48px;
    min-height: 48px;
    font-size: 13px;
}

.platform-ios .mission-pause-panel {
    width: 430px;
    max-width: 88%;
    max-height: 94%;
    padding: 15px 18px 16px 18px;
}

.platform-ios .mission-pause-title {
    margin-top: 4px;
    font-size: 23px;
}

.platform-ios .mission-pause-summary {
    height: 56px;
    margin-top: 10px;
    margin-bottom: 10px;
    padding-top: 7px;
    padding-bottom: 7px;
}

.platform-ios .pause-primary-button,
.platform-ios .pause-secondary-button,
.platform-ios .pause-settings-button {
    height: 48px;
    min-height: 48px;
    font-size: 13px;
}

.platform-ios .mission-pause-actions,
.platform-ios .pause-settings-button {
    margin-top: 6px;
}

.platform-ios .mission-pause-hint {
    display: none;
}

.platform-ios .settings-panel {
    width: 500px;
    max-width: 92%;
    height: 90%;
    max-height: 90%;
    padding: 16px 20px 18px 20px;
}

.platform-ios .settings-action-button,
.platform-ios .settings-close-button {
    min-height: 48px;
    font-size: 13px;
}

.platform-ios .settings-scroll .unity-scroll-view__vertical-scroller,
.platform-ios .settings-scroll .unity-scroll-view__horizontal-scroller {
    display: none;
}

/* Gameplay HUD uses iOS points, not desktop-sized proportions. */
.platform-ios .mission-top-anchor {
    top: 10px;
}

.platform-ios .mission-top-row {
    width: 430px;
    height: 46px;
    padding-left: 4px;
    padding-right: 4px;
}

.platform-ios .mission-hud-segment {
    height: 44px;
    padding: 4px 10px;
}

.platform-ios .mission-objective-card,
.platform-ios .mission-score-card {
    width: 164px;
}

.platform-ios .mission-timer-card {
    width: 92px;
}

.platform-ios .mission-strip-divider {
    height: 25px;
}

.platform-ios .mission-kicker {
    font-size: 9px;
    letter-spacing: 0.8px;
}

.platform-ios .mission-primary-value {
    font-size: 18px;
    letter-spacing: 0.4px;
}

.platform-ios .mission-timer {
    font-size: 20px;
    letter-spacing: 0.8px;
}

.platform-ios .mission-pause-button {
    right: 12px;
    top: 10px;
    width: 44px;
    height: 44px;
    font-size: 14px;
}

.platform-ios .mission-telemetry-stack {
    left: 12px;
    bottom: 12px;
    width: 245px;
}

.platform-ios .mission-vehicle-panel {
    width: 245px;
    height: 100px;
}

.platform-ios .mission-speedometer {
    width: 96px;
    height: 96px;
    border-top-left-radius: 48px;
    border-top-right-radius: 48px;
    border-bottom-left-radius: 48px;
    border-bottom-right-radius: 48px;
}

.platform-ios .mission-speed-tick,
.platform-ios .mission-speed-needle {
    width: 94px;
    height: 94px;
}

.platform-ios .mission-speed-tick-mark {
    left: 46px;
    top: 5px;
    width: 2px;
    height: 7px;
}

.platform-ios .mission-speed-needle-bar {
    left: 46px;
    top: 15px;
    width: 2px;
    height: 34px;
}

.platform-ios .mission-speed-hub {
    left: 43px;
    top: 43px;
    width: 8px;
    height: 8px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.platform-ios .mission-current-speed {
    top: 34px;
    font-size: 26px;
    letter-spacing: -0.8px;
}

.platform-ios .mission-speed-unit {
    top: 66px;
    font-size: 8px;
    letter-spacing: 1px;
}

.platform-ios .mission-run-status {
    width: 141px;
    min-height: 82px;
    margin-left: 8px;
    margin-bottom: 5px;
    padding-left: 9px;
}

.platform-ios .mission-vehicle-name {
    margin-bottom: 6px;
    font-size: 11px;
    letter-spacing: 0.7px;
}

.platform-ios .mission-health-tag {
    font-size: 9px;
}

.platform-ios .mission-health-value {
    font-size: 10px;
}

.platform-ios .mission-health-segments,
.platform-ios .mission-health-segment {
    height: 6px;
}

.platform-ios .mission-health-segments {
    margin-top: 5px;
}

.platform-ios .mission-health-segment {
    margin-right: 2px;
}

.platform-ios .mission-mayhem-card {
    min-height: 31px;
    margin-top: 9px;
    padding-top: 5px;
}

.platform-ios .mission-mayhem-tier,
.platform-ios .mission-mayhem-multiplier {
    font-size: 10px;
}

.platform-ios .mission-mayhem-track,
.platform-ios .mission-mayhem-fill {
    height: 3px;
}

.platform-ios .mission-mayhem-track {
    margin-top: 4px;
}
