:root {
    --garage-bg: rgba(8, 11, 14, 0.96);
    --panel-bg: rgba(18, 22, 27, 0.96);
    --panel-soft: rgba(26, 31, 37, 0.92);
    --panel-hover: rgba(37, 45, 53, 0.98);
    --border: rgba(255, 255, 255, 0.10);
    --border-strong: rgba(255, 255, 255, 0.18);
    --text: rgb(239, 244, 248);
    --text-soft: rgb(163, 174, 184);
    --text-dim: rgb(112, 124, 135);
    --accent: rgb(103, 186, 255);
    --accent-soft: rgba(103, 186, 255, 0.18);
    --positive: rgb(82, 214, 147);
    --negative: rgb(255, 102, 111);
}

.garage-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    color: var(--text);
}

.topbar {
    height: 76px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 28px;
    padding-right: 28px;
    background-color: var(--garage-bg);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.brand-row {
    flex-direction: row;
    align-items: center;
}

.brand-mark {
    margin-right: 11px;
    color: var(--accent);
    font-size: 18px;
}

.brand-title {
    color: var(--text);
    font-size: 19px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
}

.balance-block {
    align-items: flex-end;
}

.eyebrow,
.rail-title,
.stats-title,
.mission-kicker {
    color: var(--text-soft);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
}

.balance-value {
    margin-top: 2px;
    color: var(--text);
    font-size: 18px;
    -unity-font-style: bold;
}

.tabbar {
    height: 58px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 22px;
    background-color: rgba(12, 15, 19, 0.96);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.top-tab {
    height: 34px;
    margin-right: 8px;
    padding-left: 18px;
    padding-right: 18px;
    color: var(--text-soft);
    background-color: var(--panel-soft);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 17px;
    border-top-right-radius: 17px;
    border-bottom-left-radius: 17px;
    border-bottom-right-radius: 17px;
    -unity-font-style: bold;
}

.top-tab:hover {
    color: var(--text);
    background-color: var(--panel-hover);
}

.top-tab--selected {
    color: rgb(8, 13, 18);
    background-color: var(--accent);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.content-row {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
}

.rail {
    width: 265px;
    flex-shrink: 0;
    padding: 22px 18px 18px 18px;
    background-color: var(--panel-bg);
}

.left-rail {
    border-right-width: 1px;
    border-right-color: var(--border);
}

.right-rail {
    width: 310px;
    border-left-width: 1px;
    border-left-color: var(--border);
}

.rail-title {
    margin-bottom: 14px;
}

.rail-list,
.right-list {
    flex-grow: 1;
}

.rail-item {
    height: 42px;
    margin-bottom: 7px;
    padding-left: 14px;
    padding-right: 14px;
    -unity-text-align: middle-left;
    color: var(--text-soft);
    background-color: rgba(255, 255, 255, 0.035);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.rail-item:hover {
    color: var(--text);
    background-color: var(--panel-hover);
    border-left-color: var(--border-strong);
    border-right-color: var(--border-strong);
    border-top-color: var(--border-strong);
    border-bottom-color: var(--border-strong);
}

.rail-item--selected {
    color: rgb(8, 13, 18);
    background-color: var(--accent);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.filter-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.filter-chip {
    height: 29px;
    margin-right: 5px;
    margin-bottom: 5px;
    padding-left: 9px;
    padding-right: 9px;
    color: var(--text-dim);
    background-color: transparent;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    font-size: 10px;
}

.filter-chip--selected {
    color: var(--text);
    background-color: var(--accent-soft);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.center-stage {
    position: relative;
    flex-grow: 1;
    min-width: 0;
}

.stage-context {
    position: absolute;
    left: 24px;
    top: 18px;
    color: var(--text-soft);
    font-size: 13px;
    letter-spacing: 0.3px;
}

.preview-viewport {
    flex-grow: 1;
    min-height: 280px;
}

.drag-hint {
    position: absolute;
    right: 22px;
    top: 17px;
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    background-color: rgba(8, 11, 14, 0.62);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.drag-icon {
    margin-right: 6px;
    color: var(--accent);
}

.drag-copy {
    color: var(--text-dim);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
}

.stats-panel {
    min-height: 188px;
    margin: 0 18px 16px 18px;
    padding: 15px 16px 14px 16px;
    background-color: rgba(13, 17, 21, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.stats-heading-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.stats-title {
    color: var(--text);
    font-size: 12px;
}

.stats-subtitle {
    margin-top: 3px;
    color: var(--text-dim);
    font-size: 10px;
}

.live-badge {
    padding: 5px 8px;
    color: var(--accent);
    background-color: var(--accent-soft);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
}

.stat-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.stat-card {
    min-width: 145px;
    flex-grow: 1;
    margin-right: 8px;
    margin-bottom: 8px;
    padding: 10px;
    background-color: rgba(255, 255, 255, 0.035);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.stat-name {
    color: var(--text-dim);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.7px;
}

.stat-value-row {
    height: 23px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.stat-value {
    color: var(--text);
    font-size: 11px;
    -unity-font-style: bold;
}

.stat-delta {
    color: var(--text-dim);
    font-size: 10px;
    -unity-font-style: bold;
}

.stat-positive {
    color: var(--positive);
}

.stat-negative {
    color: var(--negative);
}

.stat-track {
    position: relative;
    height: 6px;
    margin-top: 5px;
    background-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    overflow: hidden;
}

.stat-current-fill,
.stat-preview-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(165, 178, 189, 0.48);
    transition-property: width, background-color;
    transition-duration: 0.16s;
}

.stat-preview-fill {
    height: 2px;
    top: auto;
    bottom: 0;
    background-color: var(--accent);
}

.stat-preview-fill--positive {
    background-color: var(--positive);
}

.stat-preview-fill--negative {
    background-color: var(--negative);
}

.slot-row {
    min-height: 78px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.slot-copy {
    flex-grow: 1;
}

.slot-label {
    color: var(--text-dim);
    font-size: 10px;
}

.slot-value {
    margin-top: 3px;
    color: var(--text);
    font-size: 13px;
    -unity-font-style: bold;
}

.slot-effect {
    max-width: 190px;
    margin-top: 3px;
    color: var(--text-dim);
    font-size: 9px;
    white-space: normal;
}

.slot-actions {
    flex-shrink: 0;
    align-items: flex-end;
}

.ghost-button {
    color: var(--text-soft);
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    font-size: 10px;
    -unity-font-style: bold;
}

.ghost-button:hover {
    color: var(--accent);
}

.ghost-button--danger {
    color: rgba(255, 102, 111, 0.72);
}

.ghost-button--danger:hover {
    color: var(--negative);
}

.detail-block {
    flex-shrink: 0;
    margin-top: 14px;
    padding-top: 16px;
    border-top-width: 1px;
    border-top-color: var(--border);
}

.detail-title {
    color: var(--text);
    font-size: 18px;
    -unity-font-style: bold;
}

.detail-description {
    min-height: 46px;
    margin-top: 7px;
    margin-bottom: 12px;
    color: var(--text-soft);
    font-size: 11px;
    white-space: normal;
}

.detail-mechanics {
    margin-bottom: 12px;
    padding: 10px 11px;
    background-color: rgba(255, 255, 255, 0.035);
    border-left-width: 2px;
    border-left-color: var(--accent);
    border-top-left-radius: 4px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 7px;
}

.detail-mechanic-kicker {
    color: var(--accent);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
}

.detail-mechanic-kicker--tradeoff {
    margin-top: 8px;
    color: var(--negative);
}

.detail-effect,
.detail-tradeoff {
    margin-top: 3px;
    color: var(--text-soft);
    font-size: 10px;
    white-space: normal;
}

.primary-action,
.mission-button {
    height: 40px;
    color: rgb(8, 13, 18);
    background-color: var(--accent);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    -unity-font-style: bold;
    letter-spacing: 0.4px;
}

.primary-action:disabled,
.mission-button:disabled {
    color: var(--text-dim);
    background-color: rgba(255, 255, 255, 0.06);
}

.context-hint {
    margin-top: 7px;
    color: var(--text-dim);
    font-size: 9px;
    white-space: normal;
}

.footerbar {
    height: 68px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 24px;
    padding-right: 22px;
    background-color: var(--garage-bg);
    border-top-width: 1px;
    border-top-color: var(--border);
}

.selected-build {
    color: var(--text-soft);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.35px;
}

.mission-button {
    min-width: 190px;
    padding-left: 18px;
    padding-right: 18px;
}

.mission-hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    pointer-events: none;
}

.mission-top-anchor {
    position: absolute;
    left: 0;
    right: 0;
    top: 18px;
    align-items: center;
}

.mission-top-row {
    width: 520px;
    height: 56px;
    flex-direction: row;
    align-items: center;
    padding: 0 5px;
    background-color: rgba(8, 11, 14, 0.88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 2px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.12);
    border-right-color: rgba(255, 255, 255, 0.12);
    border-top-color: rgba(103, 186, 255, 0.78);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.mission-hud-segment {
    height: 52px;
    padding: 6px 13px;
    justify-content: center;
}

.mission-objective-card {
    width: 198px;
}

.mission-timer-card {
    width: 116px;
    align-items: center;
}

.mission-score-card {
    width: 180px;
}

.mission-strip-divider {
    width: 1px;
    height: 33px;
    flex-shrink: 0;
    background-color: rgba(255, 255, 255, 0.12);
}

.mission-primary-value {
    margin-top: 1px;
    color: var(--text);
    font-size: 19px;
    -unity-font-style: bold;
    letter-spacing: 0.55px;
}

.mission-timer {
    margin-top: 1px;
    color: var(--text);
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
}

.mission-objective-card--complete {
    background-color: rgba(42, 112, 76, 0.24);
}

.mission-telemetry-stack {
    position: absolute;
    left: 20px;
    bottom: 20px;
    width: 372px;
}

.mission-vehicle-panel {
    position: relative;
    width: 372px;
    height: 170px;
    flex-direction: row;
    align-items: flex-end;
    background-color: transparent;
}

.mission-speedometer {
    position: relative;
    width: 166px;
    height: 166px;
    flex-shrink: 0;
    background-color: rgba(7, 10, 13, 0.70);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(132, 197, 240, 0.13);
    border-right-color: rgba(132, 197, 240, 0.13);
    border-top-color: rgba(132, 197, 240, 0.13);
    border-bottom-color: rgba(132, 197, 240, 0.13);
    border-top-left-radius: 83px;
    border-top-right-radius: 83px;
    border-bottom-left-radius: 83px;
    border-bottom-right-radius: 83px;
}

.mission-speed-tick,
.mission-speed-needle {
    position: absolute;
    left: 0;
    top: 0;
    width: 164px;
    height: 164px;
    transform-origin: 50% 50%;
}

.mission-speed-tick-mark {
    position: absolute;
    left: 81px;
    top: 9px;
    width: 2px;
    height: 10px;
    background-color: rgba(184, 211, 229, 0.40);
    border-top-left-radius: 1px;
    border-top-right-radius: 1px;
    border-bottom-left-radius: 1px;
    border-bottom-right-radius: 1px;
}

.speed-tick--0 { rotate: -120deg; }
.speed-tick--1 { rotate: -100deg; }
.speed-tick--2 { rotate: -80deg; }
.speed-tick--3 { rotate: -60deg; }
.speed-tick--4 { rotate: -40deg; }
.speed-tick--5 { rotate: -20deg; }
.speed-tick--6 { rotate: 0deg; }
.speed-tick--7 { rotate: 20deg; }
.speed-tick--8 { rotate: 40deg; }
.speed-tick--9 { rotate: 60deg; }
.speed-tick--10 { rotate: 80deg; }
.speed-tick--11 { rotate: 100deg; }
.speed-tick--12 { rotate: 120deg; }

.mission-speed-needle {
    rotate: -120deg;
}

.mission-speed-needle-bar {
    position: absolute;
    left: 80px;
    top: 25px;
    width: 3px;
    height: 59px;
    background-color: rgb(106, 194, 255);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
}

.mission-speed-hub {
    position: absolute;
    left: 77px;
    top: 77px;
    width: 10px;
    height: 10px;
    background-color: rgb(213, 234, 247);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.mission-current-speed {
    position: absolute;
    left: 0;
    right: 0;
    top: 61px;
    color: var(--text);
    font-size: 45px;
    -unity-font-style: bold;
    letter-spacing: -1.5px;
    -unity-text-align: middle-center;
}

.mission-speed-unit {
    position: absolute;
    left: 0;
    right: 0;
    top: 112px;
    color: rgba(203, 224, 238, 0.68);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1.6px;
    -unity-text-align: middle-center;
}

.mission-speedometer--fast .mission-speed-needle-bar {
    background-color: rgb(255, 173, 61);
}

.mission-run-status {
    width: 194px;
    min-height: 135px;
    margin-left: 12px;
    margin-bottom: 8px;
    padding-left: 13px;
    justify-content: flex-end;
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.15);
}

.mission-vehicle-name {
    margin-bottom: 10px;
    color: rgb(222, 232, 238);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.1px;
}

.mission-health-copy {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.mission-health-tag {
    color: rgb(106, 194, 255);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.mission-health-value {
    color: rgb(220, 229, 235);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.45px;
}

.mission-health-segments {
    height: 7px;
    margin-top: 6px;
    flex-direction: row;
}

.mission-health-segment {
    height: 7px;
    flex-grow: 1;
    margin-right: 3px;
    background-color: rgba(255, 255, 255, 0.10);
    transition-property: width, background-color;
    transition-duration: 0.12s;
}

.mission-health-segment--active {
    background-color: rgb(78, 214, 155);
}

.mission-health-segment--critical.mission-health-segment--active {
    background-color: rgb(255, 86, 91);
}

.mission-mayhem-card {
    width: 100%;
    min-height: 43px;
    margin-top: 18px;
    padding: 7px 0 0 0;
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 1px;
    border-bottom-width: 0;
    border-left-color: transparent;
    border-right-color: transparent;
    border-top-color: rgba(255, 255, 255, 0.09);
    border-bottom-color: transparent;
    transition-property: background-color;
    transition-duration: 0.16s;
}

.mission-mayhem-card--pulse {
    background-color: rgba(255, 255, 255, 0.04);
}

.mission-mayhem-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.mission-result-mayhem-label {
    color: var(--text-dim);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 1.15px;
}

.mission-mayhem-tier {
    color: var(--text-soft);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1.05px;
}

.mission-mayhem-multiplier {
    color: var(--text-soft);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.45px;
}

.mission-mayhem-track {
    position: relative;
    height: 4px;
    margin-top: 6px;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.mission-mayhem-fill {
    height: 4px;
    width: 0%;
    background-color: rgb(118, 129, 139);
    transition-property: width, background-color;
    transition-duration: 0.09s;
}

.mission-result-mayhem.mayhem-tier--rampage {
    border-left-color: rgb(255, 211, 92);
    border-right-color: rgb(255, 211, 92);
    border-top-color: rgb(255, 211, 92);
    border-bottom-color: rgb(255, 211, 92);
}

.mission-result-mayhem.mayhem-tier--carnage {
    border-left-color: rgb(255, 151, 60);
    border-right-color: rgb(255, 151, 60);
    border-top-color: rgb(255, 151, 60);
    border-bottom-color: rgb(255, 151, 60);
}

.mission-result-mayhem.mayhem-tier--slaughter {
    border-left-color: rgb(255, 80, 86);
    border-right-color: rgb(255, 80, 86);
    border-top-color: rgb(255, 80, 86);
    border-bottom-color: rgb(255, 80, 86);
}

.mission-result-mayhem.mayhem-tier--mayhem {
    border-left-color: rgb(255, 67, 197);
    border-right-color: rgb(82, 219, 255);
    border-top-color: rgb(255, 67, 197);
    border-bottom-color: rgb(82, 219, 255);
    background-color: rgba(58, 16, 53, 0.70);
}

.mission-mayhem-card.mayhem-tier--rampage {
    background-color: transparent;
}

.mission-mayhem-card.mayhem-tier--carnage {
    background-color: transparent;
}

.mission-mayhem-card.mayhem-tier--slaughter {
    background-color: transparent;
}

.mission-mayhem-card.mayhem-tier--mayhem {
    background-color: transparent;
}

.mayhem-tier--rampage .mission-mayhem-tier,
.mayhem-tier--rampage .mission-mayhem-multiplier,
.mayhem-tier--rampage .mission-result-mayhem-value { color: rgb(255, 211, 92); }
.mayhem-tier--rampage .mission-mayhem-fill { background-color: rgb(255, 211, 92); }

.mayhem-tier--carnage .mission-mayhem-tier,
.mayhem-tier--carnage .mission-mayhem-multiplier,
.mayhem-tier--carnage .mission-result-mayhem-value { color: rgb(255, 151, 60); }
.mayhem-tier--carnage .mission-mayhem-fill { background-color: rgb(255, 151, 60); }

.mayhem-tier--slaughter .mission-mayhem-tier,
.mayhem-tier--slaughter .mission-mayhem-multiplier,
.mayhem-tier--slaughter .mission-result-mayhem-value { color: rgb(255, 80, 86); }
.mayhem-tier--slaughter .mission-mayhem-fill { background-color: rgb(255, 80, 86); }

.mayhem-tier--mayhem .mission-mayhem-tier,
.mayhem-tier--mayhem .mission-mayhem-multiplier,
.mayhem-tier--mayhem .mission-result-mayhem-value { color: rgb(255, 107, 217); }
.mayhem-tier--mayhem .mission-mayhem-fill { background-color: rgb(255, 67, 197); }

.mission-mayhem-announcement {
    position: absolute;
    left: 0;
    right: 0;
    top: 42%;
    display: none;
    align-items: center;
}

.mission-mayhem-announcement-label {
    min-width: 310px;
    padding: 9px 22px;
    color: var(--text);
    background-color: rgba(8, 11, 14, 0.94);
    border-left-width: 3px;
    border-right-width: 3px;
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.mission-mayhem-announcement.mayhem-tier--rampage .mission-mayhem-announcement-label { color: rgb(255, 211, 92); }
.mission-mayhem-announcement.mayhem-tier--carnage .mission-mayhem-announcement-label { color: rgb(255, 151, 60); }
.mission-mayhem-announcement.mayhem-tier--slaughter .mission-mayhem-announcement-label { color: rgb(255, 80, 86); }
.mission-mayhem-announcement.mayhem-tier--mayhem .mission-mayhem-announcement-label { color: rgb(255, 107, 217); }

.mission-mayhem-announcement.mayhem-tier--rampage .mission-mayhem-announcement-label {
    border-left-color: rgb(255, 211, 92);
    border-right-color: rgb(255, 211, 92);
}

.mission-mayhem-announcement.mayhem-tier--carnage .mission-mayhem-announcement-label {
    border-left-color: rgb(255, 151, 60);
    border-right-color: rgb(255, 151, 60);
}

.mission-mayhem-announcement.mayhem-tier--slaughter .mission-mayhem-announcement-label {
    border-left-color: rgb(255, 80, 86);
    border-right-color: rgb(255, 80, 86);
}

.mission-mayhem-announcement.mayhem-tier--mayhem .mission-mayhem-announcement-label {
    border-left-color: rgb(255, 67, 197);
    border-right-color: rgb(82, 219, 255);
}

.mission-effect-feedback {
    display: none;
    width: 340px;
    margin-bottom: 8px;
    padding: 8px 13px;
    color: var(--text);
    background-color: rgba(8, 11, 14, 0.88);
    border-left-width: 2px;
    border-left-color: var(--accent);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.65px;
    -unity-text-align: middle-left;
}

.mission-effect-feedback--impact {
    border-left-color: rgb(255, 177, 77);
}

.mission-effect-feedback--defense {
    border-left-color: var(--accent);
}

.mission-effect-feedback--repair {
    color: var(--positive);
    border-left-color: var(--positive);
}

.mission-result {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 8, 11, 0.72);
}

.mission-result-panel {
    width: 620px;
    padding: 27px 30px 29px 30px;
    align-items: center;
    background-color: rgba(14, 18, 23, 0.98);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 3px;
    border-bottom-width: 1px;
    border-left-color: var(--border-strong);
    border-right-color: var(--border-strong);
    border-top-color: var(--border-strong);
    border-bottom-color: var(--border-strong);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

.mission-result-panel--success {
    border-top-color: var(--positive);
}

.mission-result-panel--failure {
    border-top-color: var(--negative);
}

.mission-result-eyebrow {
    color: var(--text-dim);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1.4px;
}

.mission-result-status {
    margin-top: 13px;
    padding: 5px 11px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.mission-result-status--success {
    color: var(--positive);
    background-color: rgba(82, 214, 147, 0.13);
}

.mission-result-status--failure {
    color: var(--negative);
    background-color: rgba(255, 102, 111, 0.13);
}

.mission-result-title {
    margin-top: 9px;
    color: var(--text);
    font-size: 29px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.mission-result-description {
    max-width: 480px;
    margin-top: 7px;
    color: var(--text-soft);
    font-size: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.mission-result-metrics {
    width: 100%;
    margin-top: 24px;
    flex-direction: row;
}

.mission-result-metric {
    flex-grow: 1;
    min-width: 120px;
    margin-left: 4px;
    margin-right: 4px;
    padding: 12px 8px;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.035);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}

.mission-result-metric-label {
    color: var(--text-dim);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
}

.mission-result-metric-value {
    margin-top: 5px;
    color: var(--text);
    font-size: 17px;
    -unity-font-style: bold;
}

.mission-result-mayhem {
    width: 100%;
    margin-top: 10px;
    padding: 11px 12px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.035);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}

.mission-result-mayhem-block {
    flex-grow: 1;
    align-items: center;
}

.mission-result-mayhem-value {
    margin-top: 4px;
    color: var(--text);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 0.7px;
}

.mission-result-mayhem-divider {
    width: 1px;
    height: 30px;
    background-color: var(--border);
}

.mission-result-reward {
    width: 100%;
    max-width: 520px;
    margin-top: 16px;
    padding: 12px 14px;
    background-color: rgba(118, 194, 255, 0.055);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(118, 194, 255, 0.2);
    border-right-color: rgba(118, 194, 255, 0.2);
    border-top-color: rgba(118, 194, 255, 0.2);
    border-bottom-color: rgba(118, 194, 255, 0.2);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.mission-result-reward-row,
.mission-result-reward-balance {
    height: 24px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.mission-result-reward-label,
.mission-result-reward-total-label {
    color: var(--text-dim);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
}

.mission-result-reward-value {
    color: var(--text-soft);
    font-size: 12px;
    -unity-font-style: bold;
}

.mission-result-reward-total {
    height: 35px;
    margin-top: 4px;
    padding-top: 7px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.09);
}

.mission-result-reward-total-value {
    color: var(--positive);
    font-size: 17px;
    -unity-font-style: bold;
}

.mission-result-reward-balance {
    margin-top: 4px;
}

.mission-result-reward-balance-value {
    color: var(--accent);
    font-size: 13px;
    -unity-font-style: bold;
}

.mission-result-button {
    width: 210px;
    height: 43px;
    margin-top: 24px;
    color: rgb(8, 13, 18);
    background-color: var(--accent);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
}
