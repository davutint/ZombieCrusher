    border-bottom-width: 2px;
    border-left-color: rgb(225, 91, 73);
    border-right-color: rgb(225, 91, 73);
    border-top-color: rgb(225, 91, 73);
    border-bottom-color: rgb(225, 91, 73);
}

.garage-root .stats-panel {
