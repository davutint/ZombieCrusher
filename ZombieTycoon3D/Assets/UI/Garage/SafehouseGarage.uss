:root {
    --garage-bg: rgba(8, 11, 14, 0.96);
    --panel-bg: rgba(18, 22, 27, 0.96);
    --panel-soft: rgba(26, 31, 37, 0.92);
    --panel-hover: rgba(37, 45, 53, 0.98);
    --border: rgba(255, 255, 255, 0.10);
    --border-strong: rgba(255, 255, 255, 0.18);
    --text: rgb(239, 244, 248);
    --text-soft: rgb(163, 174, 184);
    --text-dim: rgb(112, 124, 135);
    --accent: rgb(103, 186, 255);
    --accent-soft: rgba(103, 186, 255, 0.18);
    --positive: rgb(82, 214, 147);
    --negative: rgb(255, 102, 111);
}

.garage-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    color: var(--text);
}

.topbar {
    height: 76px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 28px;
    padding-right: 28px;
    background-color: var(--garage-bg);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.brand-row {
    flex-direction: row;
    align-items: center;
}

.brand-mark {
    margin-right: 11px;
    color: var(--accent);
    font-size: 18px;
}

.brand-title {
    color: var(--text);
    font-size: 19px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
}

.balance-block {
    align-items: flex-end;
}

.topbar-actions {
    flex-direction: row;
    align-items: center;
}

.topbar-settings-button {
    height: 30px;
    margin-right: 18px;
    padding-left: 13px;
    padding-right: 13px;
    color: var(--text-soft);
    background-color: transparent;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
}

.topbar-settings-button:hover {
    color: var(--text);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.eyebrow,
.rail-title,
.stats-title,
.mission-kicker {
    color: var(--text-soft);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
}

.balance-value {
    margin-top: 2px;
    color: var(--text);
    font-size: 18px;
    -unity-font-style: bold;
}

.tabbar {
    height: 58px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 22px;
    background-color: rgba(12, 15, 19, 0.96);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.top-tab {
    height: 34px;
    margin-right: 8px;
    padding-left: 18px;
    padding-right: 18px;
    color: var(--text-soft);
    background-color: var(--panel-soft);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 17px;
    border-top-right-radius: 17px;
    border-bottom-left-radius: 17px;
    border-bottom-right-radius: 17px;
    -unity-font-style: bold;
}

.top-tab:hover {
    color: var(--text);
    background-color: var(--panel-hover);
}

.top-tab--selected {
    color: rgb(8, 13, 18);
    background-color: var(--accent);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.content-row {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
}

.rail {
    width: 265px;
    flex-shrink: 0;
    padding: 22px 18px 18px 18px;
    background-color: var(--panel-bg);
}

.left-rail {
    border-right-width: 1px;
    border-right-color: var(--border);
}

.right-rail {
    width: 310px;
    border-left-width: 1px;
    border-left-color: var(--border);
}

.rail-title {
    margin-bottom: 14px;
}

.rail-list,
.right-list {
    flex-grow: 1;
}

.rail-item {
    height: 42px;
    margin-bottom: 7px;
    padding-left: 14px;
    padding-right: 14px;
    -unity-text-align: middle-left;
    color: var(--text-soft);
    background-color: rgba(255, 255, 255, 0.035);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.rail-item:hover {
    color: var(--text);
    background-color: var(--panel-hover);
    border-left-color: var(--border-strong);
    border-right-color: var(--border-strong);
    border-top-color: var(--border-strong);
    border-bottom-color: var(--border-strong);
}

.rail-item--selected {
    color: rgb(8, 13, 18);
    background-color: var(--accent);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.filter-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.filter-chip {
    height: 29px;
    margin-right: 5px;
    margin-bottom: 5px;
    padding-left: 9px;
    padding-right: 9px;
    color: var(--text-dim);
    background-color: transparent;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    font-size: 10px;
}

.filter-chip--selected {
    color: var(--text);
    background-color: var(--accent-soft);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.center-stage {
    position: relative;
    flex-grow: 1;
    min-width: 0;
}

.stage-context {
    position: absolute;
    left: 24px;
    top: 18px;
    color: var(--text-soft);
    font-size: 13px;
    letter-spacing: 0.3px;
}

.preview-viewport {
    flex-grow: 1;
    min-height: 280px;
}

.drag-hint {
    position: absolute;
    right: 22px;
    top: 17px;
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    background-color: rgba(8, 11, 14, 0.62);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.drag-icon {
    margin-right: 6px;
    color: var(--accent);
}

.drag-copy {
    color: var(--text-dim);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
}

.stats-panel {
    min-height: 188px;
    margin: 0 18px 16px 18px;
    padding: 15px 16px 14px 16px;
    background-color: rgba(13, 17, 21, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.stats-heading-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.stats-title {
    color: var(--text);
    font-size: 12px;
}

.stats-subtitle {
    margin-top: 3px;
    color: var(--text-dim);
    font-size: 10px;
}

.live-badge {
    padding: 5px 8px;
    color: var(--accent);
    background-color: var(--accent-soft);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
}

.stat-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.stat-card {
    min-width: 145px;
    flex-grow: 1;
    margin-right: 8px;
    margin-bottom: 8px;
    padding: 10px;
    background-color: rgba(255, 255, 255, 0.035);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.stat-name {
    color: var(--text-dim);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.7px;
}

.stat-value-row {
    height: 23px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.stat-value {
    color: var(--text);
    font-size: 11px;
    -unity-font-style: bold;
}

.stat-delta {
    color: var(--text-dim);
    font-size: 10px;
    -unity-font-style: bold;
}

.stat-positive {
    color: var(--positive);
}

.stat-negative {
    color: var(--negative);
}

.stat-track {
    position: relative;
    height: 6px;
    margin-top: 5px;
    background-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    overflow: hidden;
}

.stat-current-fill,
.stat-preview-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(165, 178, 189, 0.48);
    transition-property: width, background-color;
    transition-duration: 0.16s;
}

.stat-preview-fill {
    height: 2px;
    top: auto;
    bottom: 0;
    background-color: var(--accent);
}

.stat-preview-fill--positive {
    background-color: var(--positive);
}

.stat-preview-fill--negative {
    background-color: var(--negative);
}

.slot-row {
    min-height: 78px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.slot-copy {
    flex-grow: 1;
}

.slot-label {
    color: var(--text-dim);
    font-size: 10px;
}

.slot-value {
    margin-top: 3px;
    color: var(--text);
    font-size: 13px;
    -unity-font-style: bold;
}

.slot-effect {
    max-width: 190px;
    margin-top: 3px;
    color: var(--text-dim);
    font-size: 9px;
    white-space: normal;
}

.slot-actions {
    flex-shrink: 0;
    align-items: flex-end;
}

.ghost-button {
    color: var(--text-soft);
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    font-size: 10px;
    -unity-font-style: bold;
}

.ghost-button:hover {
    color: var(--accent);
}

.ghost-button--danger {
    color: rgba(255, 102, 111, 0.72);
}

.ghost-button--danger:hover {
    color: var(--negative);
}

.detail-block {
    flex-shrink: 0;
    margin-top: 14px;
    padding-top: 16px;
    border-top-width: 1px;
    border-top-color: var(--border);
}

.detail-title {
    color: var(--text);
    font-size: 18px;
    -unity-font-style: bold;
}

.detail-description {
    min-height: 46px;
    margin-top: 7px;
    margin-bottom: 12px;
    color: var(--text-soft);
    font-size: 11px;
    white-space: normal;
}

.detail-mechanics {
    margin-bottom: 12px;
    padding: 10px 11px;
    background-color: rgba(255, 255, 255, 0.035);
    border-left-width: 2px;
    border-left-color: var(--accent);
    border-top-left-radius: 4px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 7px;
}

.detail-mechanic-kicker {
    color: var(--accent);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
}

.detail-mechanic-kicker--tradeoff {
    margin-top: 8px;
    color: var(--negative);
}

.detail-effect,
.detail-tradeoff {
    margin-top: 3px;
    color: var(--text-soft);
    font-size: 10px;
    white-space: normal;
}

.primary-action,
.mission-button {
    height: 40px;
    color: rgb(8, 13, 18);
    background-color: var(--accent);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    -unity-font-style: bold;
    letter-spacing: 0.4px;
}

.primary-action:disabled,
.mission-button:disabled {
    color: var(--text-dim);
    background-color: rgba(255, 255, 255, 0.06);
}

.context-hint {
    margin-top: 7px;
    color: var(--text-dim);
    font-size: 9px;
    white-space: normal;
}

.footerbar {
    height: 82px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 24px;
    padding-right: 22px;
    background-color: var(--garage-bg);
    border-top-width: 1px;
    border-top-color: var(--border);
}

.selected-build {
    color: var(--text-soft);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.35px;
}

.footer-mission-brief {
    flex-grow: 1;
    min-width: 0;
}

.mission-brief-row {
    margin-top: 8px;
    flex-direction: row;
    align-items: center;
}

.mission-brief-value,
.mission-brief-control {
    margin-right: 14px;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.65px;
}

.mission-brief-value {
    color: var(--accent);
}

.mission-brief-control {
    color: var(--text-dim);
}

.mission-button {
    min-width: 190px;
    padding-left: 18px;
    padding-right: 18px;
}

/* Vehicle-first Safehouse Garage */
.garage-root {
    --garage-bg: rgba(7, 9, 10, 0.90);
    --panel-bg: rgba(12, 14, 15, 0.82);
    --panel-soft: rgba(24, 25, 25, 0.78);
    --panel-hover: rgba(43, 40, 38, 0.90);
    --border: rgba(238, 231, 220, 0.13);
    --border-strong: rgba(238, 231, 220, 0.26);
    --text: rgb(238, 233, 224);
    --text-soft: rgb(181, 176, 168);
    --text-dim: rgb(126, 124, 119);
    --accent: rgb(205, 76, 62);
    --accent-soft: rgba(205, 76, 62, 0.18);
    --positive: rgb(91, 201, 145);
    --negative: rgb(224, 91, 91);
    background-color: transparent;
}

.garage-root .topbar {
    height: 72px;
    padding-left: 26px;
    padding-right: 22px;
    background-color: rgba(7, 9, 10, 0.93);
    border-bottom-color: rgba(238, 231, 220, 0.09);
}

.garage-root .brand-mark {
    margin-right: 10px;
    color: rgb(211, 91, 74);
    font-size: 13px;
}

.garage-root .brand-title {
    font-size: 17px;
    letter-spacing: 1.4px;
}

.garage-root .tabbar {
    height: 72px;
    flex-grow: 1;
    justify-content: center;
    padding-left: 40px;
    padding-right: 40px;
    background-color: transparent;
    border-bottom-width: 0;
}

.garage-root .top-tab {
    height: 72px;
    margin-left: 17px;
    margin-right: 17px;
    padding-left: 0;
    padding-right: 0;
    color: rgb(144, 141, 135);
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    font-size: 12px;
    letter-spacing: 1.0px;
}

.garage-root .top-tab:hover {
    color: var(--text);
    background-color: transparent;
}

.garage-root .top-tab--selected {
    color: var(--text);
    background-color: transparent;
    border-bottom-color: var(--accent);
}

.garage-root .topbar-actions {
    min-width: 145px;
    justify-content: flex-end;
}

.garage-root .balance-block {
    align-items: flex-end;
}

.garage-root .balance-value {
    margin-top: 0;
    color: var(--text);
    font-size: 16px;
    letter-spacing: 0.6px;
}

.garage-root .topbar-settings-button {
    width: 36px;
    height: 36px;
    margin-left: 15px;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
    color: var(--text-soft);
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    font-size: 17px;
}

.garage-root .topbar-settings-button:hover {
    color: var(--text);
    background-color: rgba(238, 231, 220, 0.08);
}

.garage-root .content-row {
    position: relative;
    flex-grow: 1;
    min-height: 0;
    background-color: rgba(5, 6, 7, 0.12);
}

.garage-root .center-stage {
    position: relative;
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
}

.garage-root .stage-context {
    left: 26px;
    top: 19px;
    color: rgba(197, 191, 182, 0.78);
    font-size: 12px;
    letter-spacing: 0.45px;
}

.garage-root .preview-viewport {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    min-height: 0;
}

.garage-root .drag-hint {
    right: 24px;
    top: 17px;
    padding: 7px 10px;
    background-color: rgba(8, 9, 9, 0.58);
    border-top-left-radius: 13px;
    border-top-right-radius: 13px;
    border-bottom-left-radius: 13px;
    border-bottom-right-radius: 13px;
}

.garage-root .drag-icon {
    color: rgb(211, 91, 74);
}

.garage-root .drag-copy {
    color: rgba(177, 172, 164, 0.68);
    font-size: 10px;
    letter-spacing: 0.75px;
}

.browser-drawer,
.context-drawer,
.garage-root .stats-panel {
    background-color: rgba(11, 12, 12, 0.78);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(238, 231, 220, 0.12);
    border-right-color: rgba(238, 231, 220, 0.12);
    border-top-color: rgba(238, 231, 220, 0.12);
    border-bottom-color: rgba(238, 231, 220, 0.12);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

.browser-drawer {
    position: absolute;
    left: 24px;
    top: 68px;
    width: 336px;
    max-height: 430px;
    padding: 18px 16px 14px 16px;
}

.garage-root .rail-title {
    margin-left: 4px;
    margin-bottom: 14px;
    color: rgb(151, 147, 140);
    font-size: 11px;
    letter-spacing: 1.15px;
}

.garage-root .rail-list {
    flex-grow: 0;
    max-height: 374px;
}

.garage-root .rail-item {
    height: 55px;
    margin-bottom: 6px;
    padding-left: 15px;
    padding-right: 14px;
    color: rgb(179, 174, 166);
    background-color: rgba(238, 231, 220, 0.025);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
    -unity-text-align: middle-left;
}

.garage-root .rail-item-copy {
    flex-grow: 1;
    min-width: 0;
    justify-content: center;
}

.garage-root .rail-item-title {
    color: rgb(222, 216, 207);
    font-size: 14px;
    -unity-font-style: bold;
    white-space: nowrap;
}

.garage-root .rail-item-meta {
    margin-top: 3px;
    color: rgb(132, 129, 123);
    font-size: 10px;
    letter-spacing: 0.75px;
}

.garage-root .rail-item:hover {
    color: var(--text);
    background-color: rgba(238, 231, 220, 0.08);
}

.garage-root .rail-item--selected {
