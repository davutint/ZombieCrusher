:root {
    --garage-bg: rgba(8, 11, 14, 0.96);
    --panel-bg: rgba(18, 22, 27, 0.96);
    --panel-soft: rgba(26, 31, 37, 0.92);
    --panel-hover: rgba(37, 45, 53, 0.98);
    --border: rgba(255, 255, 255, 0.10);
    --border-strong: rgba(255, 255, 255, 0.18);
    --text: rgb(239, 244, 248);
    --text-soft: rgb(163, 174, 184);
    --text-dim: rgb(112, 124, 135);
    --accent: rgb(103, 186, 255);
    --accent-soft: rgba(103, 186, 255, 0.18);
    --positive: rgb(82, 214, 147);
    --negative: rgb(255, 102, 111);
}

.garage-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    color: var(--text);
}

.topbar {
    height: 76px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 28px;
    padding-right: 28px;
    background-color: var(--garage-bg);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.brand-row {
    flex-direction: row;
    align-items: center;
}

.brand-mark {
    margin-right: 11px;
    color: var(--accent);
    font-size: 18px;
}

.brand-title {
    color: var(--text);
    font-size: 19px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
}

.balance-block {
    align-items: flex-end;
}

.eyebrow,
.rail-title,
.stats-title,
.mission-kicker {
    color: var(--text-soft);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
}

.balance-value {
    margin-top: 2px;
    color: var(--text);
    font-size: 18px;
    -unity-font-style: bold;
}

.tabbar {
    height: 58px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 22px;
    background-color: rgba(12, 15, 19, 0.96);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.top-tab {
    height: 34px;
    margin-right: 8px;
    padding-left: 18px;
    padding-right: 18px;
    color: var(--text-soft);
    background-color: var(--panel-soft);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 17px;
    border-top-right-radius: 17px;
    border-bottom-left-radius: 17px;
    border-bottom-right-radius: 17px;
    -unity-font-style: bold;
}

.top-tab:hover {
    color: var(--text);
    background-color: var(--panel-hover);
}

.top-tab--selected {
    color: rgb(8, 13, 18);
    background-color: var(--accent);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.content-row {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
}

.rail {
    width: 265px;
    flex-shrink: 0;
    padding: 22px 18px 18px 18px;
    background-color: var(--panel-bg);
}

.left-rail {
    border-right-width: 1px;
    border-right-color: var(--border);
}

.right-rail {
    width: 310px;
    border-left-width: 1px;
    border-left-color: var(--border);
}

.rail-title {
    margin-bottom: 14px;
}

.rail-list,
.right-list {
    flex-grow: 1;
}

.rail-item {
    height: 42px;
    margin-bottom: 7px;
    padding-left: 14px;
    padding-right: 14px;
    -unity-text-align: middle-left;
    color: var(--text-soft);
    background-color: rgba(255, 255, 255, 0.035);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.rail-item:hover {
    color: var(--text);
    background-color: var(--panel-hover);
    border-left-color: var(--border-strong);
    border-right-color: var(--border-strong);
    border-top-color: var(--border-strong);
    border-bottom-color: var(--border-strong);
}

.rail-item--selected {
    color: rgb(8, 13, 18);
    background-color: var(--accent);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.filter-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.filter-chip {
    height: 29px;
    margin-right: 5px;
    margin-bottom: 5px;
    padding-left: 9px;
    padding-right: 9px;
    color: var(--text-dim);
    background-color: transparent;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    font-size: 10px;
}

.filter-chip--selected {
    color: var(--text);
    background-color: var(--accent-soft);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.center-stage {
    position: relative;
    flex-grow: 1;
    min-width: 0;
}

.stage-context {
    position: absolute;
    left: 24px;
    top: 18px;
    color: var(--text-soft);
    font-size: 13px;
    letter-spacing: 0.3px;
}

.preview-viewport {
    flex-grow: 1;
    min-height: 280px;
}

.drag-hint {
    position: absolute;
    right: 22px;
    top: 17px;
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    background-color: rgba(8, 11, 14, 0.62);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.drag-icon {
    margin-right: 6px;
    color: var(--accent);
}

.drag-copy {
    color: var(--text-dim);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
}

.stats-panel {
    min-height: 188px;
    margin: 0 18px 16px 18px;
    padding: 15px 16px 14px 16px;
    background-color: rgba(13, 17, 21, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.stats-heading-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.stats-title {
    color: var(--text);
    font-size: 12px;
}

.stats-subtitle {
    margin-top: 3px;
    color: var(--text-dim);
    font-size: 10px;
}

.live-badge {
    padding: 5px 8px;
    color: var(--accent);
    background-color: var(--accent-soft);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
}

.stat-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.stat-card {
    min-width: 145px;
    flex-grow: 1;
    margin-right: 8px;
    margin-bottom: 8px;
    padding: 10px;
    background-color: rgba(255, 255, 255, 0.035);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.stat-name {
    color: var(--text-dim);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.7px;
}

.stat-value-row {
    height: 23px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.stat-value {
    color: var(--text);
    font-size: 11px;
    -unity-font-style: bold;
}

.stat-delta {
    color: var(--text-dim);
    font-size: 10px;
    -unity-font-style: bold;
}

.stat-positive {
    color: var(--positive);
}

.stat-negative {
    color: var(--negative);
}

.stat-track {
    position: relative;
    height: 6px;
    margin-top: 5px;
    background-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    overflow: hidden;
}

.stat-current-fill,
.stat-preview-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(165, 178, 189, 0.48);
    transition-property: width, background-color;
    transition-duration: 0.16s;
}

.stat-preview-fill {
    height: 2px;
    top: auto;
    bottom: 0;
    background-color: var(--accent);
}

.stat-preview-fill--positive {
    background-color: var(--positive);
}

.stat-preview-fill--negative {
    background-color: var(--negative);
}

.slot-row {
    min-height: 61px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.slot-copy {
    flex-grow: 1;
}

.slot-label {
    color: var(--text-dim);
    font-size: 10px;
}

.slot-value {
    margin-top: 3px;
    color: var(--text);
    font-size: 13px;
    -unity-font-style: bold;
}

.ghost-button {
    color: var(--text-soft);
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    font-size: 10px;
    -unity-font-style: bold;
}

.ghost-button:hover {
    color: var(--accent);
}

.detail-block {
    flex-shrink: 0;
    margin-top: 14px;
    padding-top: 16px;
    border-top-width: 1px;
    border-top-color: var(--border);
}

.detail-title {
    color: var(--text);
    font-size: 18px;
    -unity-font-style: bold;
}

.detail-description {
    min-height: 46px;
    margin-top: 7px;
    margin-bottom: 12px;
    color: var(--text-soft);
    font-size: 11px;
    white-space: normal;
}

.primary-action,
.mission-button {
    height: 40px;
    color: rgb(8, 13, 18);
    background-color: var(--accent);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    -unity-font-style: bold;
    letter-spacing: 0.4px;
}

.primary-action:disabled,
.mission-button:disabled {
    color: var(--text-dim);
    background-color: rgba(255, 255, 255, 0.06);
}

.context-hint {
    margin-top: 7px;
    color: var(--text-dim);
    font-size: 9px;
    white-space: normal;
}

.footerbar {
    height: 68px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 24px;
    padding-right: 22px;
    background-color: var(--garage-bg);
    border-top-width: 1px;
    border-top-color: var(--border);
}

.selected-build {
    color: var(--text-soft);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.35px;
}

.mission-button {
    min-width: 190px;
    padding-left: 18px;
    padding-right: 18px;
}

.mission-hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: center;
    pointer-events: none;
}

.mission-timer-card {
    margin-top: 18px;
    align-items: center;
    padding: 9px 24px 10px 24px;
    background-color: rgba(8, 11, 14, 0.78);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
}

.mission-timer {
    margin-top: 1px;
    color: var(--text);
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
}
