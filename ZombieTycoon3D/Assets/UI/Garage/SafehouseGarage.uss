/* Two-screen showroom: the vehicle owns the stage, controls stay spatial. */
.garage-root .showroom-arrow {
    position: absolute;
    top: 45%;
    width: 68px;
    height: 68px;
    padding: 0;
    color: rgba(238, 233, 224, 0.82);
    background-color: rgba(8, 9, 9, 0.52);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(238, 231, 220, 0.20);
    border-right-color: rgba(238, 231, 220, 0.20);
    border-top-color: rgba(238, 231, 220, 0.20);
    border-bottom-color: rgba(238, 231, 220, 0.20);
    border-top-left-radius: 34px;
    border-top-right-radius: 34px;
    border-bottom-left-radius: 34px;
    border-bottom-right-radius: 34px;
    font-size: 42px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    translate: 0 -50%;
}

.garage-root .showroom-arrow:hover {
    color: rgb(255, 246, 236);
    background-color: rgba(62, 53, 49, 0.82);
    border-left-color: rgba(224, 105, 87, 0.72);
    border-right-color: rgba(224, 105, 87, 0.72);
    border-top-color: rgba(224, 105, 87, 0.72);
    border-bottom-color: rgba(224, 105, 87, 0.72);
}

.garage-root .showroom-arrow:disabled {
    opacity: 0.28;
}

.garage-root .showroom-arrow--left {
    left: 29%;
}

.garage-root .showroom-arrow--right {
    right: 29%;
}

.garage-root .showroom-caption {
    position: absolute;
    left: 50%;
    bottom: 221px;
    min-width: 230px;
    align-items: center;
    translate: -50% 0;
}

.garage-root .showroom-caption-title {
    color: rgb(232, 226, 216);
    font-size: 12px;
    letter-spacing: 1.25px;
}

.garage-root .showroom-caption-meta {
    margin-top: 5px;
    color: rgb(207, 93, 76);
    font-size: 10px;
    letter-spacing: 0.95px;
}

.garage-root .stats-panel {
    left: 26px;
    top: 50%;
    bottom: auto;
    width: 326px;
    padding: 17px 18px 15px 18px;
    translate: 0 -50%;
    background-color: rgba(9, 10, 10, 0.61);
    border-left-color: rgba(238, 231, 220, 0.08);
    border-right-color: rgba(238, 231, 220, 0.08);
    border-top-color: rgba(238, 231, 220, 0.08);
    border-bottom-color: rgba(238, 231, 220, 0.08);
}

.garage-root .stats-title {
    margin-bottom: 7px;
    color: rgb(156, 151, 143);
    font-size: 10px;
    letter-spacing: 1.25px;
}

.garage-root .stat-card {
    height: 45px;
    margin-bottom: 0;
    flex-direction: row;
    align-items: center;
    border-bottom-color: rgba(238, 231, 220, 0.075);
}

.garage-root .stat-name {
    width: 88px;
    flex-shrink: 0;
    color: rgb(145, 141, 134);
    font-size: 10px;
    letter-spacing: 0.75px;
}

.garage-root .stat-value-row {
    height: 45px;
    flex-grow: 1;
    justify-content: flex-end;
    align-items: center;
}

.garage-root .stat-value {
    flex-grow: 1;
    color: rgb(231, 225, 216);
    font-size: 13px;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.garage-root .stat-delta {
    min-width: 62px;
    margin-left: 8px;
    font-size: 12px;
    white-space: nowrap;
    -unity-text-align: middle-right;
}

/* Readable performance rows with a passive value slider beneath the text. */
.garage-root .stats-panel {
    width: 344px;
    padding: 17px 18px 14px 18px;
}

.garage-root .stat-card {
    height: 54px;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
}

.garage-root .stat-header {
    height: 31px;
    flex-direction: row;
    align-items: center;
}

.garage-root .stat-value-row {
    height: 31px;
}

.garage-root .stat-track {
    position: relative;
    width: 100%;
    height: 5px;
    margin-top: 1px;
    margin-bottom: 7px;
    background-color: rgba(238, 231, 220, 0.09);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    overflow: hidden;
}

.garage-root .stat-current-fill,
.garage-root .stat-preview-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(216, 207, 195, 0.42);
}

.garage-root .stat-preview-fill {
    top: auto;
    bottom: 0;
    height: 2px;
    background-color: rgb(205, 82, 68);
}

.garage-root .stat-preview-fill--positive {
    background-color: rgb(98, 190, 137);
}

.garage-root .stat-preview-fill--negative {
    background-color: rgb(218, 83, 88);
}

/* Keep carousel identity above the vehicle instead of over the model. */
.garage-root .showroom-caption {
    left: 50%;
    top: 17px;
    bottom: auto;
    min-width: 270px;
    height: 40px;
    padding-left: 16px;
    padding-right: 16px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    translate: -50% 0;
    background-color: rgba(8, 9, 9, 0.82);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 2px;
    border-bottom-width: 1px;
    border-left-color: rgba(238, 231, 220, 0.12);
    border-right-color: rgba(238, 231, 220, 0.12);
    border-top-color: rgba(211, 91, 74, 0.78);
    border-bottom-color: rgba(238, 231, 220, 0.12);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}

.garage-root .showroom-caption-title {
    color: rgb(238, 232, 222);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.15px;
}

.garage-root .showroom-caption-meta {
    margin-top: 0;
    margin-left: 13px;
    padding-left: 13px;
    color: rgb(216, 104, 87);
    font-size: 10px;
    letter-spacing: 0.9px;
    border-left-width: 1px;
    border-left-color: rgba(238, 231, 220, 0.14);
}

.garage-screen--gallery .context-drawer,
.garage-screen--parts .context-drawer {
    bottom: 18px;
    width: 58%;
    min-width: 720px;
    max-width: 940px;
    min-height: 116px;
    max-height: 126px;
    padding: 15px 18px 14px 20px;
}

.garage-root .detail-copy {
    padding-right: 24px;
}

.garage-root .detail-title {
    font-size: 23px;
}

.garage-root .detail-description {
    max-height: 34px;
    margin-top: 5px;
    margin-bottom: 0;
    color: rgb(166, 161, 153);
    font-size: 12px;
    overflow: hidden;
}

.garage-screen--parts .detail-mechanics {
    display: none;
}

.garage-root .detail-action-block {
    width: 252px;
    padding-left: 18px;
}

.garage-root .primary-action {
    height: 48px;
}

.garage-root .context-hint {
    margin-top: 7px;
    color: rgb(142, 137, 129);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
    -unity-text-align: middle-center;
}

.garage-root .footerbar {
    height: 76px;
    padding-left: 0;
    padding-right: 0;
}

.garage-root .mission-button {
    top: 12px;
}

.mission-hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    pointer-events: none;
}

.mission-top-anchor {
    position: absolute;
    left: 0;
    right: 0;
    top: 18px;
    align-items: center;
}

.mission-top-row {
    width: 520px;
    height: 56px;
    flex-direction: row;
    align-items: center;
    padding: 0 5px;
    background-color: rgba(8, 11, 14, 0.88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 2px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.12);
    border-right-color: rgba(255, 255, 255, 0.12);
    border-top-color: rgba(103, 186, 255, 0.78);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.mission-hud-segment {
    height: 52px;
    padding: 6px 13px;
    justify-content: center;
}

.mission-objective-card {
    width: 198px;
}

.mission-timer-card {
    width: 116px;
    align-items: center;
}

.mission-score-card {
    width: 180px;
}

.mission-strip-divider {
    width: 1px;
    height: 33px;
    flex-shrink: 0;
    background-color: rgba(255, 255, 255, 0.12);
}

.mission-primary-value {
    margin-top: 1px;
    color: var(--text);
    font-size: 19px;
    -unity-font-style: bold;
    letter-spacing: 0.55px;
}

.mission-timer {
    margin-top: 1px;
    color: var(--text);
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
}

.mission-objective-card--complete {
    background-color: rgba(42, 112, 76, 0.24);
}

.mission-telemetry-stack {
    position: absolute;
    left: 20px;
    bottom: 20px;
    width: 372px;
}

.mission-vehicle-panel {
    position: relative;
    width: 372px;
    height: 170px;
    flex-direction: row;
    align-items: flex-end;
    background-color: transparent;
}

.mission-speedometer {
    position: relative;
    width: 166px;
    height: 166px;
    flex-shrink: 0;
    background-color: rgba(7, 10, 13, 0.70);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(132, 197, 240, 0.13);
    border-right-color: rgba(132, 197, 240, 0.13);
    border-top-color: rgba(132, 197, 240, 0.13);
    border-bottom-color: rgba(132, 197, 240, 0.13);
    border-top-left-radius: 83px;
    border-top-right-radius: 83px;
    border-bottom-left-radius: 83px;
    border-bottom-right-radius: 83px;
}

.mission-speed-tick,
.mission-speed-needle {
    position: absolute;
    left: 0;
    top: 0;
    width: 164px;
    height: 164px;
    transform-origin: 50% 50%;
}

.mission-speed-tick-mark {
    position: absolute;
    left: 81px;
    top: 9px;
    width: 2px;
    height: 10px;
    background-color: rgba(184, 211, 229, 0.40);
    border-top-left-radius: 1px;
    border-top-right-radius: 1px;
    border-bottom-left-radius: 1px;
    border-bottom-right-radius: 1px;
}

.speed-tick--0 { rotate: -120deg; }
.speed-tick--1 { rotate: -100deg; }
.speed-tick--2 { rotate: -80deg; }
.speed-tick--3 { rotate: -60deg; }
.speed-tick--4 { rotate: -40deg; }
.speed-tick--5 { rotate: -20deg; }
.speed-tick--6 { rotate: 0deg; }
.speed-tick--7 { rotate: 20deg; }
.speed-tick--8 { rotate: 40deg; }
.speed-tick--9 { rotate: 60deg; }
.speed-tick--10 { rotate: 80deg; }
.speed-tick--11 { rotate: 100deg; }
.speed-tick--12 { rotate: 120deg; }

.mission-speed-needle {
    rotate: -120deg;
}

.mission-speed-needle-bar {
    position: absolute;
    left: 80px;
    top: 25px;
    width: 3px;
    height: 59px;
    background-color: rgb(106, 194, 255);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
}

.mission-speed-hub {
    position: absolute;
    left: 77px;
    top: 77px;
    width: 10px;
    height: 10px;
    background-color: rgb(213, 234, 247);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.mission-current-speed {
    position: absolute;
    left: 0;
    right: 0;
    top: 61px;
    color: var(--text);
    font-size: 45px;
    -unity-font-style: bold;
    letter-spacing: -1.5px;
    -unity-text-align: middle-center;
}

.mission-speed-unit {
    position: absolute;
    left: 0;
    right: 0;
    top: 112px;
    color: rgba(203, 224, 238, 0.68);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1.6px;
    -unity-text-align: middle-center;
}

.mission-speedometer--fast .mission-speed-needle-bar {
    background-color: rgb(255, 173, 61);
}

.mission-run-status {
    width: 194px;
    min-height: 135px;
    margin-left: 12px;
    margin-bottom: 8px;
    padding-left: 13px;
    justify-content: flex-end;
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.15);
    transition-property: background-color, border-left-color;
    transition-duration: 0.12s;
}

.mission-run-status--damage {
    background-color: rgba(255, 54, 63, 0.08);
    border-left-color: rgba(255, 86, 91, 0.92);
}

.mission-vehicle-name {
    margin-bottom: 10px;
    color: rgb(222, 232, 238);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.1px;
}

.mission-health-copy {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.mission-health-tag {
    color: rgb(106, 194, 255);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    transition-property: color;
    transition-duration: 0.1s;
}

.mission-health-value {
    color: rgb(220, 229, 235);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.45px;
    transition-property: color;
    transition-duration: 0.1s;
}

.mission-run-status--damage .mission-health-tag,
.mission-run-status--damage .mission-health-value {
    color: rgb(255, 104, 109);
}

.mission-health-segments {
    height: 7px;
    margin-top: 6px;
    flex-direction: row;
}

.mission-health-segment {
    height: 7px;
    flex-grow: 1;
    margin-right: 3px;
    background-color: rgba(255, 255, 255, 0.10);
    transition-property: width, background-color;
    transition-duration: 0.12s;
}

.mission-health-segment--active {
    background-color: rgb(78, 214, 155);
}

.mission-health-segment--critical.mission-health-segment--active {
    background-color: rgb(255, 86, 91);
}

.mission-mayhem-card {
    width: 100%;
    min-height: 43px;
    margin-top: 18px;
    padding: 7px 0 0 0;
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 1px;
    border-bottom-width: 0;
    border-left-color: transparent;
    border-right-color: transparent;
    border-top-color: rgba(255, 255, 255, 0.09);
    border-bottom-color: transparent;
    transition-property: background-color;
    transition-duration: 0.16s;
}

.mission-mayhem-card--pulse {
    background-color: rgba(255, 255, 255, 0.04);
}

.mission-mayhem-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.mission-result-mayhem-label {
    color: var(--text-dim);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 1.15px;
}

.mission-mayhem-tier {
    color: var(--text-soft);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1.05px;
}

.mission-mayhem-multiplier {
    color: var(--text-soft);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.45px;
}

.mission-mayhem-track {
    position: relative;
    height: 4px;
    margin-top: 6px;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.mission-mayhem-fill {
    height: 4px;
    width: 0%;
    background-color: rgb(118, 129, 139);
    transition-property: width, background-color;
    transition-duration: 0.09s;
}

.mission-result-mayhem.mayhem-tier--rampage {
    border-left-color: rgb(255, 211, 92);
    border-right-color: rgb(255, 211, 92);
    border-top-color: rgb(255, 211, 92);
    border-bottom-color: rgb(255, 211, 92);
}

.mission-result-mayhem.mayhem-tier--carnage {
    border-left-color: rgb(255, 151, 60);
    border-right-color: rgb(255, 151, 60);
    border-top-color: rgb(255, 151, 60);
    border-bottom-color: rgb(255, 151, 60);
}

.mission-result-mayhem.mayhem-tier--slaughter {
    border-left-color: rgb(255, 80, 86);
    border-right-color: rgb(255, 80, 86);
    border-top-color: rgb(255, 80, 86);
    border-bottom-color: rgb(255, 80, 86);
}

.mission-result-mayhem.mayhem-tier--mayhem {
    border-left-color: rgb(255, 67, 197);
    border-right-color: rgb(82, 219, 255);
    border-top-color: rgb(255, 67, 197);
    border-bottom-color: rgb(82, 219, 255);
    background-color: rgba(58, 16, 53, 0.70);
}

.mission-mayhem-card.mayhem-tier--rampage {
    background-color: transparent;
}

.mission-mayhem-card.mayhem-tier--carnage {
    background-color: transparent;
}

.mission-mayhem-card.mayhem-tier--slaughter {
    background-color: transparent;
}

.mission-mayhem-card.mayhem-tier--mayhem {
    background-color: transparent;
}

.mayhem-tier--rampage .mission-mayhem-tier,
.mayhem-tier--rampage .mission-mayhem-multiplier,
.mayhem-tier--rampage .mission-result-mayhem-value { color: rgb(255, 211, 92); }
.mayhem-tier--rampage .mission-mayhem-fill { background-color: rgb(255, 211, 92); }

.mayhem-tier--carnage .mission-mayhem-tier,
.mayhem-tier--carnage .mission-mayhem-multiplier,
.mayhem-tier--carnage .mission-result-mayhem-value { color: rgb(255, 151, 60); }
.mayhem-tier--carnage .mission-mayhem-fill { background-color: rgb(255, 151, 60); }

.mayhem-tier--slaughter .mission-mayhem-tier,
.mayhem-tier--slaughter .mission-mayhem-multiplier,
.mayhem-tier--slaughter .mission-result-mayhem-value { color: rgb(255, 80, 86); }
.mayhem-tier--slaughter .mission-mayhem-fill { background-color: rgb(255, 80, 86); }

.mayhem-tier--mayhem .mission-mayhem-tier,
.mayhem-tier--mayhem .mission-mayhem-multiplier,
.mayhem-tier--mayhem .mission-result-mayhem-value { color: rgb(255, 107, 217); }
.mayhem-tier--mayhem .mission-mayhem-fill { background-color: rgb(255, 67, 197); }

.mission-mayhem-announcement {
    position: absolute;
    left: 0;
    right: 0;
    top: 42%;
    display: none;
    align-items: center;
}

.mission-mayhem-announcement-label {
    min-width: 310px;
    padding: 9px 22px;
    color: var(--text);
    background-color: rgba(8, 11, 14, 0.94);
    border-left-width: 3px;
    border-right-width: 3px;
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.mission-mayhem-announcement.mayhem-tier--rampage .mission-mayhem-announcement-label { color: rgb(255, 211, 92); }
.mission-mayhem-announcement.mayhem-tier--carnage .mission-mayhem-announcement-label { color: rgb(255, 151, 60); }
.mission-mayhem-announcement.mayhem-tier--slaughter .mission-mayhem-announcement-label { color: rgb(255, 80, 86); }
.mission-mayhem-announcement.mayhem-tier--mayhem .mission-mayhem-announcement-label { color: rgb(255, 107, 217); }

.mission-mayhem-announcement.mayhem-tier--rampage .mission-mayhem-announcement-label {
    border-left-color: rgb(255, 211, 92);
    border-right-color: rgb(255, 211, 92);
}

.mission-mayhem-announcement.mayhem-tier--carnage .mission-mayhem-announcement-label {
    border-left-color: rgb(255, 151, 60);
    border-right-color: rgb(255, 151, 60);
}

.mission-mayhem-announcement.mayhem-tier--slaughter .mission-mayhem-announcement-label {
    border-left-color: rgb(255, 80, 86);
    border-right-color: rgb(255, 80, 86);
}

.mission-mayhem-announcement.mayhem-tier--mayhem .mission-mayhem-announcement-label {
    border-left-color: rgb(255, 67, 197);
    border-right-color: rgb(82, 219, 255);
}

.mission-effect-feedback {
    display: none;
    width: 340px;
    margin-bottom: 8px;
    padding: 8px 13px;
    color: var(--text);
    background-color: rgba(8, 11, 14, 0.88);
    border-left-width: 2px;
    border-left-color: var(--accent);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.65px;
    -unity-text-align: middle-left;
}

.mission-effect-feedback--impact {
    border-left-color: rgb(255, 177, 77);
}

.mission-effect-feedback--defense {
    border-left-color: var(--accent);
}

.mission-effect-feedback--repair {
    color: var(--positive);
    border-left-color: var(--positive);
}

.mission-result {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 8, 11, 0.72);
}

.mission-result-panel {
    width: 620px;
    padding: 27px 30px 29px 30px;
    align-items: center;
    background-color: rgba(14, 18, 23, 0.98);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 3px;
    border-bottom-width: 1px;
    border-left-color: var(--border-strong);
    border-right-color: var(--border-strong);
    border-top-color: var(--border-strong);
    border-bottom-color: var(--border-strong);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

.mission-result-panel--success {
    border-top-color: var(--positive);
}

.mission-result-panel--failure {
    border-top-color: var(--negative);
}

.mission-result-eyebrow {
    color: var(--text-dim);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1.4px;
}

.mission-result-status {
    margin-top: 13px;
    padding: 5px 11px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.mission-result-status--success {
    color: var(--positive);
    background-color: rgba(82, 214, 147, 0.13);
}

.mission-result-status--failure {
    color: var(--negative);
    background-color: rgba(255, 102, 111, 0.13);
}

.mission-result-title {
    margin-top: 9px;
    color: var(--text);
    font-size: 29px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.mission-result-description {
    max-width: 480px;
    margin-top: 7px;
    color: var(--text-soft);
    font-size: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.mission-result-metrics {
    width: 100%;
    margin-top: 24px;
    flex-direction: row;
}

.mission-result-metric {
    flex-grow: 1;
    min-width: 120px;
    margin-left: 4px;
    margin-right: 4px;
    padding: 12px 8px;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.035);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}

.mission-result-metric-label {
    color: var(--text-dim);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
}

.mission-result-metric-value {
    margin-top: 5px;
    color: var(--text);
    font-size: 17px;
    -unity-font-style: bold;
}

.mission-result-mayhem {
    width: 100%;
    margin-top: 10px;
    padding: 11px 12px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.035);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}

.mission-result-mayhem-block {
    flex-grow: 1;
    align-items: center;
}

.mission-result-mayhem-value {
    margin-top: 4px;
    color: var(--text);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 0.7px;
}

.mission-result-mayhem-divider {
    width: 1px;
    height: 30px;
    background-color: var(--border);
}

.mission-result-reward {
    width: 100%;
    max-width: 520px;
    margin-top: 16px;
    padding: 12px 14px;
    background-color: rgba(118, 194, 255, 0.055);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(118, 194, 255, 0.2);
    border-right-color: rgba(118, 194, 255, 0.2);
    border-top-color: rgba(118, 194, 255, 0.2);
    border-bottom-color: rgba(118, 194, 255, 0.2);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.mission-result-reward-row,
.mission-result-reward-balance {
    height: 24px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.mission-result-reward-label,
.mission-result-reward-total-label {
    color: var(--text-dim);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
}

.mission-result-reward-value {
    color: var(--text-soft);
    font-size: 12px;
    -unity-font-style: bold;
}

.mission-result-reward-total {
    height: 35px;
    margin-top: 4px;
    padding-top: 7px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.09);
}

.mission-result-reward-total-value {
    color: var(--positive);
    font-size: 17px;
    -unity-font-style: bold;
}

.mission-result-reward-balance {
    margin-top: 4px;
}

.mission-result-reward-balance-value {
    color: var(--accent);
    font-size: 13px;
    -unity-font-style: bold;
}

.mission-result-button {
    width: 210px;
    height: 43px;
    margin-top: 24px;
    color: rgb(8, 13, 18);
    background-color: var(--accent);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
}

.mission-pause-button {
    position: absolute;
    right: 20px;
    top: 18px;
    width: 48px;
    height: 38px;
    display: none;
    color: rgb(220, 231, 239);
    background-color: rgba(8, 11, 14, 0.78);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.15);
    border-right-color: rgba(255, 255, 255, 0.15);
    border-top-color: rgba(103, 186, 255, 0.72);
    border-bottom-color: rgba(255, 255, 255, 0.15);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    font-size: 15px;
    -unity-font-style: bold;
}

.mission-pause-button:hover {
    color: rgb(8, 13, 18);
    background-color: var(--accent);
}

.mission-intro,
.mission-pause,
.settings-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
}

.mission-intro {
    pointer-events: none;
    background-color: rgba(4, 7, 10, 0.44);
}

.mission-intro-panel {
    width: 520px;
    max-width: 88%;
    padding: 22px 26px 24px 26px;
    background-color: rgba(9, 13, 17, 0.94);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 3px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.12);
    border-right-color: rgba(255, 255, 255, 0.12);
    border-top-color: var(--accent);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.mission-intro-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.mission-intro-brand,
.mission-intro-index,
.mission-intro-label,
.mission-intro-tagline {
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1.35px;
}

.mission-intro-brand {
    color: var(--accent);
}

.mission-intro-index,
.mission-intro-label {
    color: var(--text-dim);
}

.mission-intro-vehicle {
    margin-top: 12px;
    color: var(--text);
    font-size: 25px;
    -unity-font-style: bold;
    letter-spacing: 1.4px;
}

.mission-intro-rule,
.settings-rule {
    height: 1px;
    margin-top: 13px;
    margin-bottom: 14px;
    background-color: rgba(255, 255, 255, 0.10);
}

.mission-intro-objectives {
    flex-direction: row;
    align-items: center;
}

.mission-intro-objective {
    flex-grow: 1;
}

.mission-intro-value {
    margin-top: 4px;
    color: rgb(225, 235, 242);
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 0.75px;
}

.mission-intro-divider {
    width: 1px;
    height: 39px;
    margin-left: 18px;
    margin-right: 18px;
    background-color: rgba(255, 255, 255, 0.12);
}

.mission-intro-countdown {
    margin-top: 15px;
    color: var(--accent);
    font-size: 72px;
    -unity-font-style: bold;
    letter-spacing: -2px;
    -unity-text-align: middle-center;
}

.mission-intro-tagline {
    margin-top: -4px;
    color: var(--text-soft);
    -unity-text-align: middle-center;
}

.mission-pause,
.settings-overlay {
    background-color: rgba(3, 6, 9, 0.78);
}

.mission-pause-panel,
.settings-panel {
    width: 430px;
    max-width: 88%;
    padding: 25px 27px 27px 27px;
    background-color: rgba(13, 17, 22, 0.985);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 3px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.13);
    border-right-color: rgba(255, 255, 255, 0.13);
    border-top-color: var(--accent);
    border-bottom-color: rgba(255, 255, 255, 0.13);
    border-top-left-radius: 13px;
    border-top-right-radius: 13px;
    border-bottom-left-radius: 13px;
    border-bottom-right-radius: 13px;
}

.mission-pause-eyebrow,
.settings-eyebrow {
    color: var(--accent);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1.35px;
}

.mission-pause-title,
.settings-title {
    margin-top: 8px;
    color: var(--text);
    font-size: 27px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
}

.mission-pause-summary {
    height: 70px;
    margin-top: 19px;
    margin-bottom: 18px;
    padding: 10px 12px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.035);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.mission-pause-metric {
    flex-grow: 1;
    align-items: center;
}

.mission-pause-metric-label {
    color: var(--text-dim);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 0.9px;
}

.mission-pause-metric-value {
    margin-top: 4px;
    color: var(--text);
    font-size: 16px;
    -unity-font-style: bold;
}

.mission-pause-divider {
    width: 1px;
    height: 32px;
    background-color: rgba(255, 255, 255, 0.11);
}

.pause-primary-button,
.pause-secondary-button,
.pause-settings-button,
.settings-action-button,
.settings-close-button {
    height: 41px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.75px;
}

.pause-primary-button {
    color: rgb(7, 12, 16);
    background-color: var(--accent);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.mission-pause-actions {
    margin-top: 8px;
    flex-direction: row;
}

.pause-secondary-button {
    flex-grow: 1;
    color: var(--text-soft);
    background-color: rgba(255, 255, 255, 0.045);
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
}

.pause-restart-button {
    margin-right: 6px;
}

.pause-secondary-button--danger:hover {
    color: var(--negative);
    border-left-color: rgba(255, 102, 111, 0.55);
    border-right-color: rgba(255, 102, 111, 0.55);
    border-top-color: rgba(255, 102, 111, 0.55);
    border-bottom-color: rgba(255, 102, 111, 0.55);
}

.pause-settings-button,
.settings-close-button {
    margin-top: 8px;
    color: var(--text-soft);
    background-color: transparent;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
}

.mission-pause-hint {
    margin-top: 14px;
    color: var(--text-dim);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 1.05px;
    -unity-text-align: middle-center;
}

.settings-overlay {
    background-color: rgba(3, 6, 9, 0.88);
}

.settings-volume-header,
.settings-screen-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.settings-label {
    color: var(--text-soft);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.9px;
}

.settings-value {
    color: var(--accent);
    font-size: 12px;
    -unity-font-style: bold;
}

.settings-slider {
    height: 28px;
    margin-top: 7px;
    margin-bottom: 19px;
}

.settings-slider .unity-base-slider__tracker {
    height: 5px;
    background-color: rgba(255, 255, 255, 0.10);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.settings-slider .unity-base-slider__dragger {
    width: 15px;
    height: 15px;
    background-color: var(--accent);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.settings-screen-row {
    min-height: 58px;
    padding-top: 11px;
    padding-bottom: 11px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.settings-description {
    margin-top: 4px;
    color: var(--text-dim);
    font-size: 9px;
}

.settings-action-button {
    width: 132px;
    color: var(--text);
    background-color: rgba(103, 186, 255, 0.12);
    border-left-color: rgba(103, 186, 255, 0.42);
    border-right-color: rgba(103, 186, 255, 0.42);
    border-top-color: rgba(103, 186, 255, 0.42);
    border-bottom-color: rgba(103, 186, 255, 0.42);
}
