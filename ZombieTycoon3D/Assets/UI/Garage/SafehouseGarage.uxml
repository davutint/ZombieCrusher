<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="project://database/Assets/UI/Garage/SafehouseGarage.uss?fileID=7433441132597879392&amp;guid=2a141c23a20fc334fa71298b365b8fe1&amp;type=3#SafehouseGarage" />
    <ui:VisualElement name="garage-root" class="garage-root">
        <ui:VisualElement class="topbar">
            <ui:VisualElement class="brand-row">
                <ui:Label text="◆" class="brand-mark" />
                <ui:Label text="SAFEHOUSE GARAGE" class="brand-title" />
            </ui:VisualElement>
            <ui:VisualElement class="balance-block">
                <ui:Label text="BAKİYE" class="eyebrow" />
                <ui:Label text="—" class="balance-value" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="tabbar">
            <ui:Button name="assembly-tab" text="MONTAJ" class="top-tab top-tab--selected" />
            <ui:Button name="gallery-tab" text="ARAÇ GALERİSİ" class="top-tab" />
            <ui:Button name="parts-tab" text="PARÇA DÜKKÂNI" class="top-tab" />
        </ui:VisualElement>

        <ui:VisualElement class="content-row">
            <ui:VisualElement class="rail left-rail">
                <ui:Label name="left-title" text="SAHİP OLUNAN ARAÇLAR" class="rail-title" />
                <ui:VisualElement name="left-filters" class="filter-row" />
                <ui:ScrollView name="left-list" class="rail-list" />
            </ui:VisualElement>

            <ui:VisualElement class="center-stage">
                <ui:Label name="context-label" text="Montaj tezgâhı · parçalar burada takılır" class="stage-context" />
                <ui:VisualElement name="preview-viewport" class="preview-viewport">
                    <ui:VisualElement class="drag-hint">
                        <ui:Label text="↔" class="drag-icon" />
                        <ui:Label text="ARACI ÇEVİRMEK İÇİN SÜRÜKLE" class="drag-copy" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="stats-panel">
                    <ui:VisualElement class="stats-heading-row">
                        <ui:VisualElement>
                            <ui:Label text="BUILD PERFORMANSI" class="stats-title" />
                            <ui:Label text="Mevcut değer → önizlenen değişim" class="stats-subtitle" />
                        </ui:VisualElement>
                        <ui:Label text="CANLI KARŞILAŞTIRMA" class="live-badge" />
                    </ui:VisualElement>
                    <ui:VisualElement name="stat-grid" class="stat-grid" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="rail right-rail">
                <ui:Label name="right-title" text="TAKILI PARÇALAR" class="rail-title" />
                <ui:ScrollView name="right-list" class="right-list" />
                <ui:VisualElement class="detail-block">
                    <ui:Label name="detail-title" text="Ambulans" class="detail-title" />
                    <ui:Label name="detail-description" text="" class="detail-description" />
                    <ui:Button name="context-action" text="2:00 GÖREVE ÇIK" class="primary-action" />
                    <ui:Label name="context-hint" text="" class="context-hint" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="footerbar">
            <ui:Label name="selected-build" text="SEÇİLİ BUILD" class="selected-build" />
            <ui:Button name="mission-button" text="▶  2:00 GÖREVE ÇIK" class="mission-button" />
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="mission-hud" class="mission-hud">
        <ui:VisualElement class="mission-timer-card">
            <ui:Label text="GÖREV SÜRESİ" class="mission-kicker" />
            <ui:Label name="mission-timer" text="2:00" class="mission-timer" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
