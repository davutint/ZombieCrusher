<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="project://database/Assets/UI/Garage/SafehouseGarage.uss?fileID=7433441132597879392&amp;guid=2a141c23a20fc334fa71298b365b8fe1&amp;type=3#SafehouseGarage" />
    <ui:VisualElement name="garage-root" class="garage-root garage-screen--gallery">
        <ui:VisualElement class="topbar">
            <ui:VisualElement class="brand-row">
                <ui:Label text="◆" class="brand-mark" />
                <ui:Label text="SAFEHOUSE GARAGE" class="brand-title" />
            </ui:VisualElement>

            <ui:VisualElement class="tabbar">
                <ui:Button name="gallery-tab" text="VEHICLES" class="top-tab top-tab--selected" />
                <ui:Button name="parts-tab" text="PARTS" class="top-tab" />
            </ui:VisualElement>

            <ui:VisualElement class="topbar-actions">
                <ui:VisualElement class="balance-block">
                    <ui:Label name="balance-value" text="0 SCRAP" class="balance-value" />
                </ui:VisualElement>
                <ui:Button name="garage-settings-button" text="⚙" class="topbar-settings-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="content-row">
            <ui:VisualElement class="center-stage">
                <ui:VisualElement name="preview-viewport" class="preview-viewport">
                    <ui:VisualElement class="drag-hint" picking-mode="Ignore">
                        <ui:Label text="↔" class="drag-icon" />
                        <ui:Label text="DRAG · ROTATE VEHICLE" class="drag-copy" />
                    </ui:VisualElement>
                    <ui:VisualElement name="left-filters" class="filter-row" picking-mode="Ignore" />
                    <ui:Button name="carousel-prev" text="‹" class="showroom-arrow showroom-arrow--left" />
                    <ui:Button name="carousel-next" text="›" class="showroom-arrow showroom-arrow--right" />
                    <ui:VisualElement class="showroom-caption" picking-mode="Ignore">
                        <ui:Label name="carousel-title" text="VEHICLE 1 / 6" class="showroom-caption-title" />
                        <ui:Label name="carousel-meta" text="OWNED" class="showroom-caption-meta" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="stats-panel">
                    <ui:VisualElement name="stat-grid" class="stat-grid" />
                </ui:VisualElement>

                <ui:VisualElement class="context-drawer">
                    <ui:VisualElement class="detail-block">
                        <ui:VisualElement class="detail-copy">
                            <ui:Label name="detail-title" text="Ambulance" class="detail-title" />
                            <ui:Label name="detail-description" text="" class="detail-description" />
                            <ui:VisualElement name="detail-mechanics" class="detail-mechanics">
                                <ui:Label text="" class="detail-mechanic-kicker" />
                                <ui:Label name="detail-effect" text="" class="detail-effect" />
                                <ui:Label text="" class="detail-mechanic-kicker detail-mechanic-kicker--tradeoff" />
                                <ui:Label name="detail-tradeoff" text="" class="detail-tradeoff" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-action-block">
                            <ui:Button name="context-action" text="START 2:00 RUN" class="primary-action" />
                            <ui:Label name="context-hint" text="" class="context-hint" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="footerbar">
            <ui:Button name="mission-button" text="▶  START 2:00 RUN" class="mission-button" />
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="mission-hud" class="mission-hud">
        <ui:VisualElement class="mission-top-anchor">
            <ui:VisualElement class="mission-top-row">
                <ui:VisualElement name="mission-objective-card" class="mission-hud-segment mission-objective-card">
                    <ui:Label text="KILLS" class="mission-kicker" />
                    <ui:Label name="mission-kills" text="0 / 100" class="mission-primary-value" />
                </ui:VisualElement>
                <ui:VisualElement class="mission-strip-divider" />
                <ui:VisualElement class="mission-hud-segment mission-timer-card">
                    <ui:Label text="TIME LEFT" class="mission-kicker" />
                    <ui:Label name="mission-timer" text="2:00" class="mission-timer" />
                </ui:VisualElement>
                <ui:VisualElement class="mission-strip-divider" />
                <ui:VisualElement class="mission-hud-segment mission-score-card">
                    <ui:Label text="SCORE" class="mission-kicker" />
                    <ui:Label name="mission-score" text="0" class="mission-primary-value" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="mission-telemetry-stack">
            <ui:VisualElement name="mission-effect-feedback" class="mission-effect-feedback">
                <ui:VisualElement class="mission-effect-feedback-strike">
                    <ui:VisualElement class="mission-effect-feedback-strike-main" />
                    <ui:VisualElement class="mission-effect-feedback-strike-tail" />
                </ui:VisualElement>
                <ui:VisualElement class="mission-effect-feedback-copy">
                    <ui:Label name="mission-effect-feedback-title" text="BOUNTY TARGET" class="mission-effect-feedback-title" />
                    <ui:Label name="mission-effect-feedback-detail" text="+173 SCORE" class="mission-effect-feedback-detail" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="mission-vehicle-panel">
                <ui:VisualElement name="mission-speedometer" class="mission-speedometer">
                    <ui:VisualElement class="mission-speed-tick speed-tick--0"><ui:VisualElement class="mission-speed-tick-mark" /></ui:VisualElement>
                    <ui:VisualElement class="mission-speed-tick speed-tick--1"><ui:VisualElement class="mission-speed-tick-mark" /></ui:VisualElement>
                    <ui:VisualElement class="mission-speed-tick speed-tick--2"><ui:VisualElement class="mission-speed-tick-mark" /></ui:VisualElement>
                    <ui:VisualElement class="mission-speed-tick speed-tick--3"><ui:VisualElement class="mission-speed-tick-mark" /></ui:VisualElement>
                    <ui:VisualElement class="mission-speed-tick speed-tick--4"><ui:VisualElement class="mission-speed-tick-mark" /></ui:VisualElement>
                    <ui:VisualElement class="mission-speed-tick speed-tick--5"><ui:VisualElement class="mission-speed-tick-mark" /></ui:VisualElement>
                    <ui:VisualElement class="mission-speed-tick speed-tick--6"><ui:VisualElement class="mission-speed-tick-mark" /></ui:VisualElement>
                    <ui:VisualElement class="mission-speed-tick speed-tick--7"><ui:VisualElement class="mission-speed-tick-mark" /></ui:VisualElement>
                    <ui:VisualElement class="mission-speed-tick speed-tick--8"><ui:VisualElement class="mission-speed-tick-mark" /></ui:VisualElement>
                    <ui:VisualElement class="mission-speed-tick speed-tick--9"><ui:VisualElement class="mission-speed-tick-mark" /></ui:VisualElement>
                    <ui:VisualElement class="mission-speed-tick speed-tick--10"><ui:VisualElement class="mission-speed-tick-mark" /></ui:VisualElement>
                    <ui:VisualElement class="mission-speed-tick speed-tick--11"><ui:VisualElement class="mission-speed-tick-mark" /></ui:VisualElement>
                    <ui:VisualElement class="mission-speed-tick speed-tick--12"><ui:VisualElement class="mission-speed-tick-mark" /></ui:VisualElement>
                    <ui:VisualElement name="mission-speed-needle" class="mission-speed-needle">
                        <ui:VisualElement class="mission-speed-needle-bar" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mission-speed-hub" />
                    <ui:Label name="mission-current-speed" text="0" class="mission-current-speed" />
                    <ui:Label text="KM/H" class="mission-speed-unit" />
                </ui:VisualElement>

                <ui:VisualElement name="mission-run-status" class="mission-run-status">
                    <ui:Label name="mission-vehicle-name" text="AMBULANCE" class="mission-vehicle-name" />
                    <ui:VisualElement class="mission-health-copy">
                        <ui:Label text="HP" class="mission-health-tag" />
                        <ui:Label name="mission-health" text="100 / 100" class="mission-health-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mission-health-segments">
                        <ui:VisualElement name="mission-health-segment-0" class="mission-health-segment mission-health-segment--active" />
                        <ui:VisualElement name="mission-health-segment-1" class="mission-health-segment mission-health-segment--active" />
                        <ui:VisualElement name="mission-health-segment-2" class="mission-health-segment mission-health-segment--active" />
                        <ui:VisualElement name="mission-health-segment-3" class="mission-health-segment mission-health-segment--active" />
                        <ui:VisualElement name="mission-health-segment-4" class="mission-health-segment mission-health-segment--active" />
                        <ui:VisualElement name="mission-health-segment-5" class="mission-health-segment mission-health-segment--active" />
                        <ui:VisualElement name="mission-health-segment-6" class="mission-health-segment mission-health-segment--active" />
                        <ui:VisualElement name="mission-health-segment-7" class="mission-health-segment mission-health-segment--active" />
                    </ui:VisualElement>

                    <ui:VisualElement name="mission-mayhem-card" class="mission-mayhem-card mayhem-tier--none">
                        <ui:VisualElement class="mission-mayhem-header">
                            <ui:Label name="mission-mayhem-tier" text="MAYHEM" class="mission-mayhem-tier" />
                            <ui:Label name="mission-mayhem-multiplier" text="x1.00" class="mission-mayhem-multiplier" />
                        </ui:VisualElement>
                        <ui:VisualElement class="mission-mayhem-track">
                            <ui:VisualElement name="mission-mayhem-fill" class="mission-mayhem-fill">
                                <ui:VisualElement name="mission-mayhem-fill-head" class="mission-mayhem-fill-head" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="mission-mayhem-announcement" class="mission-mayhem-announcement mayhem-tier--none">
            <ui:VisualElement class="mission-mayhem-streak-pack mission-mayhem-streak-pack--left">
                <ui:VisualElement class="mission-mayhem-streak mission-mayhem-streak--long" />
                <ui:VisualElement class="mission-mayhem-streak mission-mayhem-streak--medium" />
                <ui:VisualElement class="mission-mayhem-streak mission-mayhem-streak--short" />
            </ui:VisualElement>
            <ui:VisualElement class="mission-mayhem-announcement-copy">
                <ui:Label name="mission-mayhem-announcement-label" text="RAMPAGE" class="mission-mayhem-announcement-label" />
                <ui:VisualElement class="mission-mayhem-announcement-meta">
                    <ui:VisualElement class="mission-mayhem-announcement-rule" />
                    <ui:Label name="mission-mayhem-announcement-multiplier" text="x1.15" class="mission-mayhem-announcement-multiplier" />
                    <ui:VisualElement class="mission-mayhem-announcement-rule" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="mission-mayhem-streak-pack mission-mayhem-streak-pack--right">
                <ui:VisualElement class="mission-mayhem-streak mission-mayhem-streak--long" />
                <ui:VisualElement class="mission-mayhem-streak mission-mayhem-streak--medium" />
                <ui:VisualElement class="mission-mayhem-streak mission-mayhem-streak--short" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:Button name="mission-pause-button" text="Ⅱ" class="mission-pause-button" />

    <ui:VisualElement name="mission-result" class="mission-result">
        <ui:VisualElement name="mission-result-panel" class="mission-result-panel">
            <ui:Label text="SAFEHOUSE MISSION REPORT" class="mission-result-eyebrow" />
            <ui:Label name="result-status" text="SUCCESS" class="mission-result-status" />
            <ui:Label name="result-title" text="MISSION COMPLETE" class="mission-result-title" />
            <ui:Label name="result-description" text="" class="mission-result-description" />
            <ui:VisualElement class="mission-result-metrics">
                <ui:VisualElement class="mission-result-metric">
                    <ui:Label text="KILLS" class="mission-result-metric-label" />
                    <ui:Label name="result-kills" text="0 / 100" class="mission-result-metric-value" />
                </ui:VisualElement>
                <ui:VisualElement class="mission-result-metric">
                    <ui:Label text="SCORE" class="mission-result-metric-label" />
                    <ui:Label name="result-score" text="0" class="mission-result-metric-value" />
                </ui:VisualElement>
                <ui:VisualElement class="mission-result-metric">
                    <ui:Label text="BONUS KILLS" class="mission-result-metric-label" />
                    <ui:Label name="result-bonus-kills" text="0" class="mission-result-metric-value" />
                </ui:VisualElement>
                <ui:VisualElement class="mission-result-metric">
                    <ui:Label text="VEHICLE" class="mission-result-metric-label" />
                    <ui:Label name="result-health" text="0 / 100" class="mission-result-metric-value" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="result-mayhem" class="mission-result-mayhem mayhem-tier--none">
                <ui:VisualElement class="mission-result-mayhem-block">
                    <ui:Label text="PEAK KILL RATE" class="mission-result-mayhem-label" />
                    <ui:Label name="result-mayhem-tier" text="NO HEAT" class="mission-result-mayhem-value" />
                </ui:VisualElement>
                <ui:VisualElement class="mission-result-mayhem-divider" />
                <ui:VisualElement class="mission-result-mayhem-block">
                    <ui:Label text="LONGEST CHAIN" class="mission-result-mayhem-label" />
                    <ui:Label name="result-best-chain" text="0 KILLS" class="mission-result-mayhem-value" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="mission-result-reward">
                <ui:VisualElement class="mission-result-reward-row">
                    <ui:Label text="KILL SCRAP" class="mission-result-reward-label" />
                    <ui:Label name="result-kill-scrap" text="+0" class="mission-result-reward-value" />
                </ui:VisualElement>
                <ui:VisualElement class="mission-result-reward-row">
                    <ui:Label text="MISSION BONUS" class="mission-result-reward-label" />
                    <ui:Label name="result-success-bonus" text="+0" class="mission-result-reward-value" />
                </ui:VisualElement>
                <ui:VisualElement class="mission-result-reward-total">
                    <ui:Label text="TOTAL PAYOUT" class="mission-result-reward-total-label" />
                    <ui:Label name="result-total-scrap" text="+0 SCRAP" class="mission-result-reward-total-value" />
                </ui:VisualElement>
                <ui:VisualElement class="mission-result-reward-balance">
                    <ui:Label text="NEW BALANCE" class="mission-result-reward-label" />
                    <ui:Label name="result-balance" text="0 SCRAP" class="mission-result-reward-balance-value" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="result-button" text="RETURN TO GARAGE" class="mission-result-button" />
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="mission-intro" class="mission-intro">
        <ui:VisualElement class="mission-intro-stage">
            <ui:VisualElement class="mission-intro-title-lockup">
                <ui:VisualElement class="mission-intro-title-rule" />
                <ui:Label name="mission-intro-vehicle" text="AMBULANCE" class="mission-intro-vehicle" />
                <ui:VisualElement class="mission-intro-title-rule mission-intro-title-rule--right" />
            </ui:VisualElement>
            <ui:VisualElement class="mission-intro-objectives">
                <ui:VisualElement class="mission-intro-objective">
                    <ui:Label text="TARGET" class="mission-intro-label" />
                    <ui:Label text="100 KILLS" class="mission-intro-value" />
                </ui:VisualElement>
                <ui:VisualElement class="mission-intro-divider" />
                <ui:VisualElement class="mission-intro-objective">
                    <ui:Label text="TIME" class="mission-intro-label" />
                    <ui:Label text="02:00" class="mission-intro-value" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="mission-intro-countdown-row">
                <ui:VisualElement class="mission-intro-countdown-rule" />
                <ui:VisualElement name="mission-intro-countdown-shell" class="mission-intro-countdown-shell">
                    <ui:VisualElement class="mission-intro-countdown-ring" />
                    <ui:Label name="mission-intro-countdown" text="3" class="mission-intro-countdown" />
                </ui:VisualElement>
                <ui:VisualElement class="mission-intro-countdown-rule mission-intro-countdown-rule--right" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="mission-pause" class="mission-pause">
        <ui:VisualElement class="mission-pause-panel">
            <ui:Label text="SAFEHOUSE // MISSION 01" class="mission-pause-eyebrow" />
            <ui:Label text="PAUSED" class="mission-pause-title" />
            <ui:VisualElement class="mission-pause-summary">
                <ui:VisualElement class="mission-pause-metric">
                    <ui:Label text="TIME LEFT" class="mission-pause-metric-label" />
                    <ui:Label name="pause-timer" text="02:00" class="mission-pause-metric-value" />
                </ui:VisualElement>
                <ui:VisualElement class="mission-pause-divider" />
                <ui:VisualElement class="mission-pause-metric">
                    <ui:Label text="KILLS" class="mission-pause-metric-label" />
                    <ui:Label name="pause-kills" text="0 / 100" class="mission-pause-metric-value" />
                </ui:VisualElement>
                <ui:VisualElement class="mission-pause-divider" />
                <ui:VisualElement class="mission-pause-metric">
                    <ui:Label text="SCORE" class="mission-pause-metric-label" />
                    <ui:Label name="pause-score" text="0" class="mission-pause-metric-value" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="pause-resume-button" text="RESUME" class="pause-primary-button" />
            <ui:VisualElement class="mission-pause-actions">
                <ui:Button name="pause-restart-button" text="RESTART" class="pause-secondary-button pause-restart-button" />
                <ui:Button name="pause-garage-button" text="RETURN TO GARAGE" class="pause-secondary-button pause-secondary-button--danger" />
            </ui:VisualElement>
            <ui:Button name="pause-settings-button" text="SETTINGS" class="pause-settings-button" />
            <ui:Label text="ESC  RESUME" class="mission-pause-hint" />
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="settings-overlay" class="settings-overlay">
        <ui:VisualElement class="settings-panel">
            <ui:Label text="SAFEHOUSE" class="settings-eyebrow" />
            <ui:Label text="SETTINGS" class="settings-title" />
            <ui:VisualElement class="settings-rule" />
            <ui:VisualElement class="settings-volume-header">
                <ui:Label text="MASTER VOLUME" class="settings-label" />
                <ui:Label name="master-volume-value" text="80%" class="settings-value" />
            </ui:VisualElement>
            <ui:Slider name="master-volume" low-value="0" high-value="1" value="0.8" class="settings-slider" />
            <ui:VisualElement class="settings-screen-row">
                <ui:VisualElement>
                    <ui:Label text="DISPLAY" class="settings-label" />
                    <ui:Label text="Browser fullscreen" class="settings-description" />
                </ui:VisualElement>
                <ui:Button name="fullscreen-button" text="FULLSCREEN" class="settings-action-button" />
            </ui:VisualElement>
            <ui:Button name="settings-close-button" text="BACK" class="settings-close-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
