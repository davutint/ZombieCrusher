<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="project://database/Assets/UI/Garage/SafehouseGarage.uss?fileID=7433441132597879392&amp;guid=2a141c23a20fc334fa71298b365b8fe1&amp;type=3#SafehouseGarage" />
    <ui:VisualElement name="garage-root" class="garage-root">
        <ui:VisualElement class="topbar">
            <ui:VisualElement class="brand-row">
                <ui:Label text="◆" class="brand-mark" />
                <ui:Label text="SAFEHOUSE GARAGE" class="brand-title" />
            </ui:VisualElement>
            <ui:VisualElement class="balance-block">
                <ui:Label text="BAKİYE" class="eyebrow" />
                <ui:Label name="balance-value" text="0 HURDA" class="balance-value" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="tabbar">
            <ui:Button name="assembly-tab" text="MONTAJ" class="top-tab top-tab--selected" />
            <ui:Button name="gallery-tab" text="ARAÇ GALERİSİ" class="top-tab" />
            <ui:Button name="parts-tab" text="PARÇA DÜKKÂNI" class="top-tab" />
        </ui:VisualElement>

        <ui:VisualElement class="content-row">
            <ui:VisualElement class="rail left-rail">
                <ui:Label name="left-title" text="SAHİP OLUNAN ARAÇLAR" class="rail-title" />
                <ui:VisualElement name="left-filters" class="filter-row" />
                <ui:ScrollView name="left-list" class="rail-list" />
            </ui:VisualElement>

            <ui:VisualElement class="center-stage">
                <ui:Label name="context-label" text="Montaj tezgâhı · parçalar burada takılır" class="stage-context" />
                <ui:VisualElement name="preview-viewport" class="preview-viewport">
                    <ui:VisualElement class="drag-hint">
                        <ui:Label text="↔" class="drag-icon" />
                        <ui:Label text="ARACI ÇEVİRMEK İÇİN SÜRÜKLE" class="drag-copy" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="stats-panel">
                    <ui:VisualElement class="stats-heading-row">
                        <ui:VisualElement>
                            <ui:Label text="BUILD PERFORMANSI" class="stats-title" />
                            <ui:Label text="Mevcut değer → önizlenen değişim" class="stats-subtitle" />
                        </ui:VisualElement>
                        <ui:Label text="CANLI KARŞILAŞTIRMA" class="live-badge" />
                    </ui:VisualElement>
                    <ui:VisualElement name="stat-grid" class="stat-grid" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="rail right-rail">
                <ui:Label name="right-title" text="TAKILI PARÇALAR" class="rail-title" />
                <ui:ScrollView name="right-list" class="right-list" />
                <ui:VisualElement class="detail-block">
                    <ui:Label name="detail-title" text="Ambulans" class="detail-title" />
                    <ui:Label name="detail-description" text="" class="detail-description" />
                    <ui:VisualElement name="detail-mechanics" class="detail-mechanics">
                        <ui:Label text="PASIF ETKI" class="detail-mechanic-kicker" />
                        <ui:Label name="detail-effect" text="" class="detail-effect" />
                        <ui:Label text="BEDEL" class="detail-mechanic-kicker detail-mechanic-kicker--tradeoff" />
                        <ui:Label name="detail-tradeoff" text="" class="detail-tradeoff" />
                    </ui:VisualElement>
                    <ui:Button name="context-action" text="2:00 GÖREVE ÇIK" class="primary-action" />
                    <ui:Label name="context-hint" text="" class="context-hint" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="footerbar">
            <ui:Label name="selected-build" text="SEÇİLİ BUILD" class="selected-build" />
            <ui:Button name="mission-button" text="▶  2:00 GÖREVE ÇIK" class="mission-button" />
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="mission-hud" class="mission-hud">
        <ui:VisualElement class="mission-top-row">
            <ui:VisualElement name="mission-objective-card" class="mission-hud-card mission-objective-card">
                <ui:Label text="İMHA HEDEFİ" class="mission-kicker" />
                <ui:Label name="mission-kills" text="0 / 100" class="mission-primary-value" />
                <ui:Label name="mission-objective-status" text="100 KILL KALDI" class="mission-support-value" />
            </ui:VisualElement>
            <ui:VisualElement class="mission-hud-card mission-timer-card">
                <ui:Label text="GÖREV SÜRESİ" class="mission-kicker" />
                <ui:Label name="mission-timer" text="2:00" class="mission-timer" />
            </ui:VisualElement>
            <ui:VisualElement class="mission-hud-card mission-score-card">
                <ui:Label text="PUAN" class="mission-kicker" />
                <ui:Label name="mission-score" text="0" class="mission-primary-value" />
                <ui:Label text="HEDEF SONRASI ×2" class="mission-support-value" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="mission-effect-feedback" text="" class="mission-effect-feedback" />
        <ui:VisualElement class="mission-health-card">
            <ui:VisualElement class="mission-health-copy">
                <ui:Label text="ARAÇ DAYANIKLILIĞI" class="mission-kicker" />
                <ui:Label name="mission-health" text="100 / 100" class="mission-health-value" />
            </ui:VisualElement>
            <ui:VisualElement class="mission-health-track">
                <ui:VisualElement name="mission-health-fill" class="mission-health-fill" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="mission-result" class="mission-result">
        <ui:VisualElement name="mission-result-panel" class="mission-result-panel">
            <ui:Label text="SAFEHOUSE GÖREV RAPORU" class="mission-result-eyebrow" />
            <ui:Label name="result-status" text="BAŞARILI" class="mission-result-status" />
            <ui:Label name="result-title" text="GÖREV TAMAMLANDI" class="mission-result-title" />
            <ui:Label name="result-description" text="" class="mission-result-description" />
            <ui:VisualElement class="mission-result-metrics">
                <ui:VisualElement class="mission-result-metric">
                    <ui:Label text="İMHA" class="mission-result-metric-label" />
                    <ui:Label name="result-kills" text="0 / 100" class="mission-result-metric-value" />
                </ui:VisualElement>
                <ui:VisualElement class="mission-result-metric">
                    <ui:Label text="PUAN" class="mission-result-metric-label" />
                    <ui:Label name="result-score" text="0" class="mission-result-metric-value" />
                </ui:VisualElement>
                <ui:VisualElement class="mission-result-metric">
                    <ui:Label text="BONUS KILL" class="mission-result-metric-label" />
                    <ui:Label name="result-bonus-kills" text="0" class="mission-result-metric-value" />
                </ui:VisualElement>
                <ui:VisualElement class="mission-result-metric">
                    <ui:Label text="ARAÇ" class="mission-result-metric-label" />
                    <ui:Label name="result-health" text="0 / 100" class="mission-result-metric-value" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="mission-result-reward">
                <ui:VisualElement class="mission-result-reward-row">
                    <ui:Label text="KILL HURDASI" class="mission-result-reward-label" />
                    <ui:Label name="result-kill-scrap" text="+0" class="mission-result-reward-value" />
                </ui:VisualElement>
                <ui:VisualElement class="mission-result-reward-row">
                    <ui:Label text="GÖREV BONUSU" class="mission-result-reward-label" />
                    <ui:Label name="result-success-bonus" text="+0" class="mission-result-reward-value" />
                </ui:VisualElement>
                <ui:VisualElement class="mission-result-reward-total">
                    <ui:Label text="TOPLAM KAZANÇ" class="mission-result-reward-total-label" />
                    <ui:Label name="result-total-scrap" text="+0 HURDA" class="mission-result-reward-total-value" />
                </ui:VisualElement>
                <ui:VisualElement class="mission-result-reward-balance">
                    <ui:Label text="YENİ BAKİYE" class="mission-result-reward-label" />
                    <ui:Label name="result-balance" text="0 HURDA" class="mission-result-reward-balance-value" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="result-button" text="GARAJA DÖN" class="mission-result-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
